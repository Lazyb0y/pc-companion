<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
    xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="PC Companion"
      Manufacturer="PC Companion"
      Version="$(var.Version)"
      UpgradeCode="52686E02-C65A-47D6-8F24-F7A0CF243D9C"
      Scope="perUserOrMachine">

    <!--
      Another build of the same version replaces the installed one too, as every build is 0.0.1 for
      now: each has its own product code, and Windows Installer compares only three parts of a version.
      The installed one is removed after PC Companion is closed, below.
    -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        Schedule="afterInstallExecute"
        DowngradeErrorMessage="A newer version of PC Companion is already installed." />
    <!--
      Windows Installer looks for the installed version only in the scope being installed. With the
      setup pages, it looks before the scope is chosen, in the just-for-you scope, and the install
      doesn't look again, so an install for all users would go next to the installed one. The
      scope page looks again once the scope is chosen, after setting ALLUSERS, and forgets what it
      found before.
    -->
    <UI>
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="WIX_UPGRADE_DETECTED" Value="{}" Order="4" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="WIX_DOWNGRADE_DETECTED" Value="{}" Order="4" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Event="DoAction" Value="FindRelatedProducts" Order="5" />
    </UI>

    <!--
      Setup closes the settings app and the host before it removes or replaces their files, so it
      needs no restart. First, before InstallValidate, where Windows Installer looks for files in
      use and would ask to close them, it runs the installed host with its exit argument, as the
      user: the host closes both, as Exit in its tray menu does, and waits for them to end. The
      host is found by its component, whose GUID only builds that know the argument have; an older
      build would ignore it and start, keeping setup waiting. Secure, so it reaches the install
      when setup elevates.
    -->
    <Property Id="INSTALLEDHOST" Secure="yes">
      <ComponentSearch Guid="6580E42F-84A7-4438-B327-1E6D2CB9F919" Type="file">
        <!-- Without it, the search finds only the folder. -->
        <FileSearch Name="PCCompanion.Host.exe" />
      </ComponentSearch>
    </Property>
    <CustomAction Id="ExitPCCompanion" Property="INSTALLEDHOST" ExeCommand="--exit" Execute="immediate" Return="ignore" />
    <!--
      What still runs, setup closes itself: it sends their windows WM_CLOSE as the user, then, after
      five seconds, ends whatever still runs, as administrator. That covers older builds and a host
      running as administrator, which a message from the user may not reach. WiX schedules this
      before InstallFiles, after RemoveFiles; it runs right after InstallInitialize instead, and
      InstallExecute ends the processes before the installed version is removed: inside the
      transaction, RemoveExistingProducts must follow InstallInitialize or InstallExecute directly
      (error 2613). Ending a process needs the transaction, so this can't run before InstallValidate.
    -->
    <util:CloseApplication Id="CloseSettingsApp" Target="PCCompanion.exe" CloseMessage="yes" TerminateProcess="1" RebootPrompt="no" Timeout="5000" />
    <util:CloseApplication Id="CloseHost" Target="PCCompanion.Host.exe" CloseMessage="yes" TerminateProcess="1" RebootPrompt="no" Timeout="5000" />
    <InstallExecuteSequence>
      <Custom Action="ExitPCCompanion" Before="InstallValidate" Condition="INSTALLEDHOST" />
      <Custom Action="override Wix4CloseApplications_$(sys.BUILDARCHSHORT)" After="InstallInitialize" Condition="VersionNT &gt; 400" />
      <InstallExecute After="Wix4CloseApplications_$(sys.BUILDARCHSHORT)" />
    </InstallExecuteSequence>
    <MediaTemplate EmbedCab="yes" />

    <!-- The icon shown in Settings > Apps and on the Start menu shortcut. -->
    <Icon Id="PCCompanion.ico" SourceFile="..\PCCompanion.App\Assets\PCCompanion.ico" />
    <Property Id="ARPPRODUCTICON" Value="PCCompanion.ico" />

    <!-- Install dialog with a "Just for me" / "Everyone" choice; per-user is the default. -->
    <ui:WixUI Id="WixUI_Advanced" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <!-- Drawn from the app icon by scripts\installer-images.ps1. -->
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Dialog.bmp" />
    <Property Id="ApplicationFolderName" Value="PCCompanion" />
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />
    <!--
      Replace the dialog's defaults (%LOCALAPPDATA%\Apps and 32-bit Program Files) before it picks the folder.
      The dialog starts per-user, when ProgramFiles64Folder points at %LOCALAPPDATA%\Programs, so the
      all-users folder comes from ProgramW6432, which always holds the 64-bit Program Files folder.
    -->
    <SetProperty Id="WixPerUserFolder" Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]" Before="WixSetPerUserFolder" Sequence="both" />
    <SetProperty Id="WixPerMachineFolder" Value="[%ProgramW6432]\[ApplicationFolderName]" Before="WixSetPerUserFolder" Sequence="both" />

    <!--
      There are no optional features, so Advanced skips the dialog's feature page: the scope page
      (just for you) and the folder page (all users) go straight to the Ready to install page.
      Windows Installer opens the last NewDialog whose condition is true, so these rows override the
      dialog's own ones. Without features, Settings > Apps and the maintenance page offer no Change.
    -->
    <UI>
      <Publish Dialog="InstallScopeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="8" Condition="WixAppFolder = &quot;WixPerUserFolder&quot;" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallScopeDlg" Order="4" Condition="NOT Installed AND WixAppFolder = &quot;WixPerUserFolder&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="5" Condition="NOT Installed AND WixAppFolder = &quot;WixPerMachineFolder&quot;" />
    </UI>
    <Property Id="ARPNOMODIFY" Value="1" />

    <!--
      Remove goes through a page of our own, with Keep my settings unchecked, which sets
      KEEPSETTINGS=1: see RemoveUserData below. Its text is English only, like the rest of the
      installer's own text.
    -->
    <UI>
      <Dialog Id="KeepSettingsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Your settings" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose whether to keep your settings when PC Companion is removed." />
        <Control Id="Text" Type="Text" X="25" Y="60" Width="320" Height="30" NoPrefix="yes" Text="Removing PC Companion also removes your settings and logs. Keep your settings to use them again if you install PC Companion later." />
        <Control Id="KeepSettings" Type="CheckBox" X="25" Y="100" Width="320" Height="17" Property="KEEPSETTINGS" CheckBoxValue="1" Text="&amp;Keep my settings" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="KeepSettingsDlg" Order="10" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="KeepSettingsDlg" Order="6" Condition="Installed AND WixUI_InstallMode = &quot;Remove&quot;" />
    </UI>

    <!--
      The last page offers to open PC Companion, on by default. It shows only after an install or
      an upgrade, not after a repair or a removal; silent installs have no pages and open nothing.
      The pages run with the rights setup was started with, not the admin rights the install gets.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open PC Companion" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- The file's path: the pages' APPLICATIONFOLDER property may lack its trailing backslash. -->
    <CustomAction Id="OpenApp" Directory="APPLICATIONFOLDER" ExeCommand="&quot;[#SettingsApp]&quot;" Return="asyncNoWait" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenApp" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="APPLICATIONFOLDER" Name="PCCompanion">
        <Files Include="!(bindpath.InstallFiles)\**">
          <!-- Windows Installer validation (ICE03) doesn't recognize these language IDs. -->
          <Exclude Files="!(bindpath.InstallFiles)\gd-gb\**" />
          <Exclude Files="!(bindpath.InstallFiles)\mi-NZ\**" />
          <Exclude Files="!(bindpath.InstallFiles)\ug-CN\**" />
          <Exclude Files="!(bindpath.InstallFiles)\PCCompanion.exe" />
          <Exclude Files="!(bindpath.InstallFiles)\PCCompanion.Host.exe" />
          <Exclude Files="!(bindpath.InstallFiles)\PCCompanion.Elevated.exe" />
        </Files>

        <!--
          Named, so the last page can open it. Uninstalling it also removes the all-users data
          folder; see MachineDataFolder below.
        -->
        <Component Id="SettingsApp">
          <File Id="SettingsApp" Source="!(bindpath.InstallFiles)\PCCompanion.exe" KeyPath="yes" />
          <util:RemoveFolderEx Property="MachineDataFolder" On="uninstall" Condition="MachineDataFolder" />
        </Component>

        <!-- Setup finds it by this GUID to close PC Companion; see ExitPCCompanion above. -->
        <Component Id="Host" Guid="6580E42F-84A7-4438-B327-1E6D2CB9F919">
          <File Id="Host" Source="!(bindpath.InstallFiles)\PCCompanion.Host.exe" KeyPath="yes" />
        </Component>

        <!-- Named, so uninstalling can run it. -->
        <Component Id="ElevatedHelper">
          <File Id="ElevatedHelper" Source="!(bindpath.InstallFiles)\PCCompanion.Elevated.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!--
      All-users installs only: where the host writes its logs while it runs as administrator
      (docs/features/general/run-as-administrator.md). Only SYSTEM and Administrators can change
      these folders; users can read them.
    -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ProgramDataFolder" Name="PCCompanion">
        <Directory Id="ProtectedLogsFolder" Name="Logs">
          <Component Id="ProtectedLogsFolder" Guid="6E794474-9C7F-4D3F-A2D1-21776D26CBEF" Condition="ALLUSERS=1">
            <CreateFolder Directory="ProgramDataFolder">
              <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
            </CreateFolder>
            <CreateFolder>
              <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
            </CreateFolder>
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!--
      Uninstalling deletes the scheduled tasks of Always run as administrator, for every user. An
      upgrade keeps them, since the new host is in the same place. It never fails the uninstall.
    -->
    <!--
      Uninstalling removes the user's %LOCALAPPDATA%\PCCompanion, with the settings and logs, or,
      with KEEPSETTINGS=1 (Keep my settings on the setup pages), everything in it but settings.json.
      Uninstalling from Settings > Apps shows no setup pages, so it always removes them. The host
      removes the folder, as the user who uninstalls, for both kinds of install: any program running
      as the user can change that folder, so with only the user's rights, a link planted there leads
      only to what the user could remove anyway. Links are removed without what they lead to. Other
      users' folders stay. It runs before the host's file is removed, so an uninstall that is rolled
      back doesn't bring the data back. An upgrade keeps everything.
    -->
    <Property Id="KEEPSETTINGS" Secure="yes" />
    <CustomAction Id="RemoveUserData" FileRef="Host" ExeCommand="--remove-data" Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="RemoveUserDataKeepSettings" FileRef="Host" ExeCommand="--remove-data --keep-settings" Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveUserData" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT (KEEPSETTINGS=1)" />
      <Custom Action="RemoveUserDataKeepSettings" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND KEEPSETTINGS=1" />
    </InstallExecuteSequence>

    <!--
      Uninstalling an all-users install also removes %ProgramData%\PCCompanion, with the host's logs
      while it ran as administrator, which only administrators can change. It runs as administrator.
    -->
    <SetProperty Id="MachineDataFolder" Value="[CommonAppDataFolder]PCCompanion" Before="Wix4RemoveFoldersEx_$(sys.BUILDARCHSHORT)" Sequence="execute" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND ALLUSERS=1" />

    <CustomAction Id="DeleteStartupTasks" FileRef="ElevatedHelper" ExeCommand="delete-all-startup-tasks" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="DeleteStartupTasks" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND ALLUSERS=1" />
    </InstallExecuteSequence>

    <!--
      Windows starts the host at every sign-in: HKCU for a per-user install, HKLM for all users.
      The host exits at once unless the user turned on Start with Windows. Uninstalling removes the entry.
    -->
    <Component Id="StartupEntry" Directory="APPLICATIONFOLDER">
      <RegistryValue
          Root="HKMU"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="PCCompanion"
          Type="string"
          Value="&quot;[APPLICATIONFOLDER]PCCompanion.Host.exe&quot; --startup"
          KeyPath="yes" />
    </Component>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <!--
          Its own icon, which Windows Installer keeps with its copy of the package, rather than the
          one in PCCompanion.exe, which Windows can fail to show on the first start after an install.
        -->
        <Shortcut
            Id="AppShortcut"
            Name="PC Companion"
            Target="[APPLICATIONFOLDER]PCCompanion.exe"
            WorkingDirectory="APPLICATIONFOLDER"
            Icon="PCCompanion.ico" />
        <RegistryValue
            Root="HKCU"
            Key="Software\PCCompanion"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
