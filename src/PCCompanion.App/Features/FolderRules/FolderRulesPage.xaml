<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.FolderRules.FolderRulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.FolderRules"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=FolderRulesDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=FolderRulesName}" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.IsPaused}"
                    Message="{app:Localized Key=FolderRulesAdministratorInfo}"
                    Severity="Warning" />

                <Grid Margin="0,24,0,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=FolderRulesFoldersHeader}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{app:Localized Key=FolderRulesFoldersDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <DropDownButton
                        x:Name="AddFolderButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="{app:Localized Key=FolderRulesAddFolder}"
                        IsEnabled="{x:Bind ViewModel.CanAddFolder, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="{app:Localized Key=FolderRulesAddFolder}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Click="OnAddKnownFolderClick" Tag="Downloads" Text="{app:Localized Key=FolderRulesAddDownloads}" />
                                <MenuFlyoutItem Click="OnAddKnownFolderClick" Tag="Desktop" Text="{app:Localized Key=FolderRulesAddDesktop}" />
                                <MenuFlyoutItem Click="OnAddKnownFolderClick" Tag="Documents" Text="{app:Localized Key=FolderRulesAddDocuments}" />
                                <MenuFlyoutItem Click="OnAddKnownFolderClick" Tag="Pictures" Text="{app:Localized Key=FolderRulesAddPictures}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="OnBrowseClick" Text="{app:Localized Key=FolderRulesAddBrowse}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>

                <controls:Note
                    IsOpen="{x:Bind ViewModel.HasAddProblem, Mode=OneWay}"
                    Message="{x:Bind ViewModel.AddProblem, Mode=OneWay}"
                    Severity="Warning" />

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{app:Localized Key=FolderRulesNoFolders}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoFolders, Mode=OneWay}" />

                <ItemsControl
                    x:Name="FolderList"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Folders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:FolderItem">
                            <controls:IconExpander
                                Description="{x:Bind Path}"
                                Glyph="&#xE8B7;"
                                Header="{x:Bind Name}"
                                IsExpanded="True"
                                ItemsSource="{x:Bind Rules}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleSwitch
                                        AutomationProperties.Name="{x:Bind WatchName}"
                                        IsOn="{x:Bind IsEnabled}"
                                        OffContent=""
                                        OnContent=""
                                        Tag="{x:Bind Index}"
                                        Toggled="OnFolderToggled" />
                                    <Button
                                        AutomationProperties.AutomationId="FolderMore"
                                        AutomationProperties.Name="{x:Bind MoreName}"
                                        Tag="{x:Bind Index}"
                                        ToolTipService.ToolTip="{x:Bind MoreName}">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    Click="OnRemoveFolderClick"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=FolderRulesRemove}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <controls:IconExpander.ItemsHeader>
                                    <StackPanel>
                                        <InfoBar
                                            IsClosable="False"
                                            IsOpen="{x:Bind HasProblem}"
                                            Message="{x:Bind Problem}"
                                            Severity="{x:Bind ProblemSeverity}" />
                                        <toolkit:SettingsCard
                                            Description="{app:Localized Key=FolderRulesRulesDescription}"
                                            Header="{app:Localized Key=FolderRulesRulesHeader}" />
                                        <toolkit:SettingsCard
                                            Header="{app:Localized Key=FolderRulesNoRules}"
                                            Visibility="{x:Bind HasNoRules}" />
                                    </StackPanel>
                                </controls:IconExpander.ItemsHeader>
                                <controls:IconExpander.ItemTemplate>
                                    <DataTemplate x:DataType="local:RuleItem">
                                        <toolkit:SettingsCard Description="{x:Bind Summary}" Header="{x:Bind Name}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ToggleSwitch
                                                    AutomationProperties.Name="{x:Bind SwitchName}"
                                                    IsOn="{x:Bind IsEnabled}"
                                                    OffContent=""
                                                    OnContent=""
                                                    Tag="{x:Bind Tag}"
                                                    Toggled="OnRuleToggled" />
                                                <Button
                                                    AutomationProperties.AutomationId="RuleMore"
                                                    AutomationProperties.Name="{x:Bind MoreName}"
                                                    Tag="{x:Bind Tag}"
                                                    ToolTipService.ToolTip="{x:Bind MoreName}">
                                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE712;" />
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem
                                                                Click="OnMoveUpClick"
                                                                IsEnabled="{x:Bind CanMoveUp}"
                                                                Tag="{x:Bind Tag}"
                                                                Text="{app:Localized Key=FolderRulesMoveUp}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74A;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem
                                                                Click="OnMoveDownClick"
                                                                IsEnabled="{x:Bind CanMoveDown}"
                                                                Tag="{x:Bind Tag}"
                                                                Text="{app:Localized Key=FolderRulesMoveDown}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74B;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem
                                                                Click="OnDeleteRuleClick"
                                                                Tag="{x:Bind Tag}"
                                                                Text="{app:Localized Key=FolderRulesDelete}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </toolkit:SettingsCard>
                                    </DataTemplate>
                                </controls:IconExpander.ItemTemplate>
                            </controls:IconExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:PermissionsCard Description="{app:Localized Key=FolderRulesPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
