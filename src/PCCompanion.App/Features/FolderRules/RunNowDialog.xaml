<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PCCompanion.App.Features.FolderRules.RunNowDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.FolderRules"
    CloseButtonText="{app:Localized Key=FolderRulesCancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind List.CanRun, Mode=OneWay}"
    PrimaryButtonClick="OnRunClick"
    PrimaryButtonText="{app:Localized Key=FolderRulesRun}"
    Style="{ThemeResource DefaultContentDialogStyle}"
    Title="{x:Bind List.Title}">

    <StackPanel MinWidth="440" Spacing="8">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{app:Localized Key=FolderRulesRunNowDescription}"
            TextWrapping="Wrap" />
        <TextBlock
            controls:Announcement.IsLive="True"
            Text="{x:Bind List.Status, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind List.HasStatus, Mode=OneWay}" />
        <ListView
            MaxHeight="400"
            AutomationProperties.Name="{x:Bind List.Title}"
            ItemsSource="{x:Bind List.Files}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:RunNowChoice">
                    <CheckBox
                        Padding="8,6,0,6"
                        AutomationProperties.HelpText="{x:Bind Help}"
                        AutomationProperties.Name="{x:Bind Name}"
                        IsChecked="{x:Bind IsChosen, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock FlowDirection="LeftToRight" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind What}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Rule}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
