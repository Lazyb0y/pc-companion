<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PCCompanion.App.Features.FolderRules.FolderRuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.FolderRules"
    CloseButtonText="{app:Localized Key=FolderRulesCancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind Editor.CanSave, Mode=OneWay}"
    PrimaryButtonText="{app:Localized Key=FolderRulesSave}"
    Style="{ThemeResource DefaultContentDialogStyle}"
    Title="{x:Bind Editor.Title}">

    <!-- Patterns, extensions, sites, paths and new names read left to right in every language. -->
    <StackPanel MinWidth="440" Spacing="16">
        <StackPanel Spacing="4">
            <TextBox
                x:Name="NameBox"
                AutomationProperties.HelpText="{x:Bind Editor.NameProblem, Mode=OneWay}"
                Header="{app:Localized Key=FolderRulesNameHeader}"
                PlaceholderText="{app:Localized Key=FolderRulesNamePlaceholder}"
                Text="{x:Bind Editor.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                controls:Announcement.IsLive="True"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Editor.NameProblem, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Editor.HasNameProblem, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{app:Localized Key=FolderRulesNameNote}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=FolderRulesConditionsHeader}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{app:Localized Key=FolderRulesConditionsNote}"
                TextWrapping="Wrap" />
            <TextBlock
                controls:Announcement.IsLive="True"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{app:Localized Key=FolderRulesRuleNoCondition}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Editor.HasNoCondition, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <ToggleSwitch Header="{app:Localized Key=FolderRulesNamesSwitch}" IsOn="{x:Bind Editor.NamesOn, Mode=TwoWay}" />
            <StackPanel Spacing="4" Visibility="{x:Bind Editor.NamesOn, Mode=OneWay}">
                <TextBox
                    AutomationProperties.HelpText="{x:Bind Editor.NamesProblem, Mode=OneWay}"
                    AutomationProperties.Name="{app:Localized Key=FolderRulesNamesSwitch}"
                    FlowDirection="LeftToRight"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="invoice*;receipt*"
                    Text="{x:Bind Editor.Names, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Editor.NamesProblem, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Editor.HasNamesProblem, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{app:Localized Key=FolderRulesNamesNote}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <ToggleSwitch Header="{app:Localized Key=FolderRulesTypeSwitch}" IsOn="{x:Bind Editor.TypeOn, Mode=TwoWay}" />
            <StackPanel Spacing="4" Visibility="{x:Bind Editor.TypeOn, Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        AutomationProperties.HelpText="{x:Bind Editor.ExtensionsProblem, Mode=OneWay}"
                        AutomationProperties.Name="{app:Localized Key=FolderRulesTypeSwitch}"
                        FlowDirection="LeftToRight"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="pdf; docx"
                        Text="{x:Bind Editor.Extensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DropDownButton Grid.Column="1" Content="{app:Localized Key=FolderRulesAddKind}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Click="OnAddKindClick" Tag="Documents" Text="{app:Localized Key=FolderRulesKindDocuments}" />
                                <MenuFlyoutItem Click="OnAddKindClick" Tag="Pictures" Text="{app:Localized Key=FolderRulesKindPictures}" />
                                <MenuFlyoutItem Click="OnAddKindClick" Tag="Videos" Text="{app:Localized Key=FolderRulesKindVideos}" />
                                <MenuFlyoutItem Click="OnAddKindClick" Tag="Music" Text="{app:Localized Key=FolderRulesKindMusic}" />
                                <MenuFlyoutItem Click="OnAddKindClick" Tag="Archives" Text="{app:Localized Key=FolderRulesKindArchives}" />
                                <MenuFlyoutItem Click="OnAddKindClick" Tag="Installers" Text="{app:Localized Key=FolderRulesKindInstallers}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
                <TextBlock
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Editor.ExtensionsProblem, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Editor.HasExtensionsProblem, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{app:Localized Key=FolderRulesTypeNote}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <ToggleSwitch Header="{app:Localized Key=FolderRulesSizeSwitch}" IsOn="{x:Bind Editor.SizeOn, Mode=TwoWay}" />
            <StackPanel Spacing="8" Visibility="{x:Bind Editor.SizeOn, Mode=OneWay}">
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox Content="{app:Localized Key=FolderRulesLargerThan}" IsChecked="{x:Bind Editor.LargerThanOn, Mode=TwoWay}" />
                    <NumberBox
                        Grid.Column="1"
                        AutomationProperties.Name="{x:Bind LargerThanNumberName}"
                        IsEnabled="{x:Bind Editor.LargerThanOn, Mode=OneWay}"
                        Maximum="1000000"
                        Minimum="1"
                        Value="{x:Bind Editor.LargerThan, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Column="2"
                        AutomationProperties.Name="{x:Bind LargerThanUnitName}"
                        IsEnabled="{x:Bind Editor.LargerThanOn, Mode=OneWay}"
                        ItemsSource="{x:Bind Units}"
                        SelectedIndex="{x:Bind Editor.LargerThanUnit, Mode=TwoWay}" />
                    <CheckBox
                        Grid.Row="1"
                        Content="{app:Localized Key=FolderRulesSmallerThan}"
                        IsChecked="{x:Bind Editor.SmallerThanOn, Mode=TwoWay}" />
                    <NumberBox
                        Grid.Row="1"
                        Grid.Column="1"
                        AutomationProperties.Name="{x:Bind SmallerThanNumberName}"
                        IsEnabled="{x:Bind Editor.SmallerThanOn, Mode=OneWay}"
                        Maximum="1000000"
                        Minimum="1"
                        Value="{x:Bind Editor.SmallerThan, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="2"
                        AutomationProperties.Name="{x:Bind SmallerThanUnitName}"
                        IsEnabled="{x:Bind Editor.SmallerThanOn, Mode=OneWay}"
                        ItemsSource="{x:Bind Units}"
                        SelectedIndex="{x:Bind Editor.SmallerThanUnit, Mode=TwoWay}" />
                </Grid>
                <TextBlock
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Editor.SizeProblem, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Editor.HasSizeProblem, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <ToggleSwitch Header="{app:Localized Key=FolderRulesDateSwitch}" IsOn="{x:Bind Editor.DateOn, Mode=TwoWay}" />
            <StackPanel Spacing="8" Visibility="{x:Bind Editor.DateOn, Mode=OneWay}">
                <ComboBox
                    Header="{app:Localized Key=FolderRulesDateWhich}"
                    ItemsSource="{x:Bind DateChoices}"
                    SelectedIndex="{x:Bind Editor.DateWhich, Mode=TwoWay}" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox Content="{app:Localized Key=FolderRulesMoreThanDays}" IsChecked="{x:Bind Editor.MoreThanOn, Mode=TwoWay}" />
                    <NumberBox
                        Grid.Column="1"
                        AutomationProperties.Name="{x:Bind MoreThanNumberName}"
                        IsEnabled="{x:Bind Editor.MoreThanOn, Mode=OneWay}"
                        Maximum="36500"
                        Minimum="0"
                        Value="{x:Bind Editor.MoreThanDays, Mode=TwoWay}" />
                    <CheckBox
                        Grid.Row="1"
                        Content="{app:Localized Key=FolderRulesLessThanDays}"
                        IsChecked="{x:Bind Editor.LessThanOn, Mode=TwoWay}" />
                    <NumberBox
                        Grid.Row="1"
                        Grid.Column="1"
                        AutomationProperties.Name="{x:Bind LessThanNumberName}"
                        IsEnabled="{x:Bind Editor.LessThanOn, Mode=OneWay}"
                        Maximum="36500"
                        Minimum="1"
                        Value="{x:Bind Editor.LessThanDays, Mode=TwoWay}" />
                </Grid>
                <TextBlock
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Editor.DateProblem, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Editor.HasDateProblem, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <ToggleSwitch Header="{app:Localized Key=FolderRulesSitesSwitch}" IsOn="{x:Bind Editor.SitesOn, Mode=TwoWay}" />
            <StackPanel Spacing="4" Visibility="{x:Bind Editor.SitesOn, Mode=OneWay}">
                <TextBox
                    AutomationProperties.HelpText="{x:Bind Editor.SitesProblem, Mode=OneWay}"
                    AutomationProperties.Name="{app:Localized Key=FolderRulesSitesSwitch}"
                    FlowDirection="LeftToRight"
                    InputScope="Url"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="*.example.com"
                    Text="{x:Bind Editor.Sites, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Editor.SitesProblem, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Editor.HasSitesProblem, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{app:Localized Key=FolderRulesSitesNote}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <RadioButtons Header="{app:Localized Key=FolderRulesActionHeader}" SelectedIndex="{x:Bind Editor.ActionIndex, Mode=TwoWay}">
                <RadioButton Content="{app:Localized Key=FolderRulesActionMove}" />
                <RadioButton Content="{app:Localized Key=FolderRulesActionCopy}" />
                <RadioButton Content="{app:Localized Key=FolderRulesActionRename}" />
                <RadioButton Content="{app:Localized Key=FolderRulesActionRecycleBin}" />
            </RadioButtons>
            <!-- A rule from a newer version has no action chosen, and keeps its own until one is. -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{app:Localized Key=FolderRulesUnknownActionNote}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Editor.IsUnknownAction, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{app:Localized Key=FolderRulesNoRecycleBin}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Editor.ShowsNoRecycleBin, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Spacing="4" Visibility="{x:Bind Editor.IsMoveOrCopy, Mode=OneWay}">
            <TextBlock Text="{app:Localized Key=FolderRulesDestinationHeader}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.HelpText="{x:Bind Editor.DestinationProblem, Mode=OneWay}"
                    AutomationProperties.Name="{app:Localized Key=FolderRulesDestinationHeader}"
                    FlowDirection="LeftToRight"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind Editor.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    Click="OnBrowseClick"
                    Content="{app:Localized Key=FolderRulesBrowse}" />
            </Grid>
            <TextBlock
                controls:Announcement.IsLive="True"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Editor.DestinationProblem, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Editor.HasDestinationProblem, Mode=OneWay}" />
            <StackPanel Spacing="8" Visibility="{x:Bind Editor.IsDestinationMissing, Mode=OneWay}">
                <TextBlock
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{app:Localized Key=FolderRulesDestinationMissing}"
                    TextWrapping="Wrap" />
                <Button Click="OnCreateFolderClick" Content="{app:Localized Key=FolderRulesCreateFolder}" />
                <TextBlock
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Editor.CreateProblem, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Editor.HasCreateProblem, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{app:Localized Key=FolderRulesDestinationNote}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4" Visibility="{x:Bind Editor.HasName, Mode=OneWay}">
            <TextBox
                AutomationProperties.HelpText="{x:Bind Editor.NewNameProblem, Mode=OneWay}"
                FlowDirection="LeftToRight"
                Header="{x:Bind Editor.NewNameHeader, Mode=OneWay}"
                IsSpellCheckEnabled="False"
                PlaceholderText="{}{date} {name}"
                Text="{x:Bind Editor.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                controls:Announcement.IsLive="True"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Editor.NewNameProblem, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Editor.HasNewNameProblem, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{app:Localized Key=FolderRulesNewNameNote}"
                TextWrapping="Wrap" />
            <RadioButtons
                Margin="0,12,0,0"
                Header="{app:Localized Key=FolderRulesIfExistsHeader}"
                SelectedIndex="{x:Bind Editor.IfExistsIndex, Mode=TwoWay}">
                <RadioButton Content="{app:Localized Key=FolderRulesIfExistsAddNumber}" />
                <RadioButton Content="{app:Localized Key=FolderRulesIfExistsSkip}" />
            </RadioButtons>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{app:Localized Key=FolderRulesUnknownIfExistsNote}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Editor.IsUnknownIfExists, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=FolderRulesFilesHeader}" />
            <TextBlock
                controls:Announcement.IsLive="True"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Editor.MatchCount, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Editor.FilesStatus, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Editor.HasFilesStatus, Mode=OneWay}" />
            <ListView
                MaxHeight="320"
                AutomationProperties.Name="{app:Localized Key=FolderRulesFilesHeader}"
                ItemsSource="{x:Bind Editor.Files}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:RuleFileItem">
                        <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind AutomationName}">
                            <TextBlock
                                FlowDirection="LeftToRight"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Outcome}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Details}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </StackPanel>
</ContentDialog>
