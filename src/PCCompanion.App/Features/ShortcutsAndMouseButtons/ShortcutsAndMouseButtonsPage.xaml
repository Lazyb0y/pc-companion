<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.ShortcutsAndMouseButtons.ShortcutsAndMouseButtonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.ShortcutsAndMouseButtons"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=ShortcutsAndMouseButtonsDescription}"
                    DrawnIcon="{x:Bind ViewModel.DrawnIcon}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=ShortcutsAndMouseButtonsName}" />

                <Grid Margin="0,24,0,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=ShortcutsAndMouseButtonsTriggersHeader}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{app:Localized Key=ShortcutsAndMouseButtonsTriggersDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="{app:Localized Key=ShortcutsAndMouseButtonsAddName}"
                        Click="OnAddClick"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="{app:Localized Key=ShortcutsAndMouseButtonsAdd}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{app:Localized Key=ShortcutsAndMouseButtonsNoTriggers}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoTriggers, Mode=OneWay}" />

                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Triggers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:TriggerItem">
                            <StackPanel>
                                <toolkit:SettingsCard Description="{x:Bind Action}" Header="{x:Bind Input}">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind Glyph}" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            AutomationProperties.Name="{x:Bind EditName}"
                                            Click="OnEditClick"
                                            Content="{app:Localized Key=ShortcutsAndMouseButtonsEdit}"
                                            Tag="{x:Bind Index}" />
                                        <Button AutomationProperties.Name="{x:Bind MoreName}" ToolTipService.ToolTip="{x:Bind MoreName}">
                                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE712;" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        Click="OnDeleteClick"
                                                        Tag="{x:Bind Index}"
                                                        Text="{app:Localized Key=ShortcutsAndMouseButtonsDelete}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </toolkit:SettingsCard>
                                <controls:Note
                                    ButtonCommand="{x:Bind WarningCommand}"
                                    ButtonContent="{x:Bind WarningButton}"
                                    IsOpen="{x:Bind HasWarning}"
                                    Message="{x:Bind Warning}"
                                    Severity="Warning" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:SwitchCard
                    Margin="0,16,0,0"
                    Description="{app:Localized Key=ShortcutsAndMouseButtonsPauseDescription}"
                    Glyph="&#xE7FC;"
                    Header="{app:Localized Key=ShortcutsAndMouseButtonsPauseHeader}"
                    IsOn="{x:Bind ViewModel.PauseMouseButtonsInFullScreen, Mode=TwoWay}" />

                <StackPanel Margin="0,24,0,4" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=ShortcutsAndMouseButtonsOtherHeader}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{app:Localized Key=ShortcutsAndMouseButtonsOtherDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{app:Localized Key=ShortcutsAndMouseButtonsNoOther}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoOtherShortcuts}" />

                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.OtherShortcuts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:OtherShortcutItem">
                            <controls:ButtonCard
                                ButtonCommand="{x:Bind Open}"
                                ButtonContent="{x:Bind OpenText}"
                                Description="{x:Bind Action}"
                                Glyph="&#xE765;"
                                Header="{x:Bind Input}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:Note Margin="0,16,0,0" Message="{app:Localized Key=ShortcutsAndMouseButtonsBackForwardInfo}" />

                <controls:Note Margin="0,8,0,0" Message="{x:Bind ViewModel.AdministratorInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=ShortcutsAndMouseButtonsPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
