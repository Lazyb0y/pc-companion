<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.HideApps.HideAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=HideAppsDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=HideAppsName}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=HideAppsHideAppDescription}"
                    Glyph="&#xE765;"
                    Header="{app:Localized Key=HideAppsHideAppHeader}"
                    ItemsSource="{x:Bind ViewModel.HideAppShortcuts}"
                    SelectedItem="{x:Bind ViewModel.SelectedHideAppShortcut, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=HideAppsHideOthersDescription}"
                    Glyph="&#xE765;"
                    Header="{app:Localized Key=HideAppsHideOthersHeader}"
                    ItemsSource="{x:Bind ViewModel.HideOthersShortcuts}"
                    SelectedItem="{x:Bind ViewModel.SelectedHideOthersShortcut, Mode=TwoWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=HideAppsFrontDisplayOnlyDescription}"
                    Glyph="&#xE7F4;"
                    Header="{app:Localized Key=HideAppsFrontDisplayOnlyHeader}"
                    IsOn="{x:Bind ViewModel.FrontDisplayOnly, Mode=TwoWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=HideAppsWholeAppDescription}"
                    Glyph="&#xE7C4;"
                    Header="{app:Localized Key=HideAppsWholeAppHeader}"
                    IsOn="{x:Bind ViewModel.BringBackWholeApp, Mode=TwoWay}" />

                <controls:Note Margin="0,16,0,0" Message="{x:Bind ViewModel.StayInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=HideAppsPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
