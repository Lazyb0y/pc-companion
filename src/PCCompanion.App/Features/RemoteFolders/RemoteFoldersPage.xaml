<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.RemoteFolders.RemoteFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.RemoteFolders"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=RemoteFoldersDescription}"
                    DrawnIcon="{x:Bind ViewModel.DrawnIcon}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=RemoteFoldersName}" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.IsProfileNotSupported}"
                    Message="{app:Localized Key=RemoteFoldersNotNtfs}"
                    Severity="Warning" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.IsNotRunning, Mode=OneWay}"
                    Message="{app:Localized Key=RemoteFoldersNotRunning}"
                    Severity="Warning" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.HasActionProblem, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ActionProblem, Mode=OneWay}"
                    Severity="Error" />

                <controls:Note
                    ButtonCommand="{x:Bind ViewModel.OpenRemovedFolderCommand}"
                    ButtonContent="{app:Localized Key=RemoteFoldersOpenFolder}"
                    IsOpen="{x:Bind ViewModel.HasRemoved, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Removed, Mode=OneWay}"
                    Severity="Informational" />

                <Grid Margin="0,24,0,4" ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=RemoteFoldersServersHeader}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{app:Localized Key=RemoteFoldersServersDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="AddServerButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="{app:Localized Key=RemoteFoldersAddServer}"
                        Click="OnAddClick"
                        IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="{app:Localized Key=RemoteFoldersAddServer}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{app:Localized Key=RemoteFoldersNoServers}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoServers, Mode=OneWay}" />

                <ItemsControl
                    x:Name="ServerList"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Servers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:RemoteServerItem">
                            <controls:IconExpander
                                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                Description="{x:Bind Description, Mode=OneWay}"
                                Glyph="&#xE8B7;"
                                Header="{x:Bind Name}"
                                IsExpanded="{x:Bind HasDetails, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="OpenFolder"
                                        AutomationProperties.Name="{x:Bind OpenFolderName}"
                                        Click="OnOpenFolderClick"
                                        Content="{app:Localized Key=RemoteFoldersOpenFolder}"
                                        Tag="{x:Bind Index}" />
                                    <Button
                                        AutomationProperties.AutomationId="SyncNow"
                                        AutomationProperties.Name="{x:Bind SyncNowName}"
                                        Click="OnSyncNowClick"
                                        Content="{app:Localized Key=RemoteFoldersSyncNow}"
                                        IsEnabled="{x:Bind CanSync, Mode=OneWay}"
                                        Tag="{x:Bind Index}" />
                                    <Button
                                        AutomationProperties.AutomationId="More"
                                        AutomationProperties.Name="{x:Bind MoreName}"
                                        Tag="{x:Bind Index}"
                                        ToolTipService.ToolTip="{x:Bind MoreName}">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    Click="OnEditClick"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=RemoteFoldersEdit}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="OnRemoveClick"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=RemoteFoldersRemove}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <controls:IconExpander.ItemsHeader>
                                    <StackPanel>
                                        <InfoBar
                                            IsClosable="False"
                                            IsOpen="{x:Bind HasProblem, Mode=OneWay}"
                                            Message="{x:Bind Problem, Mode=OneWay}"
                                            Severity="Error">
                                            <InfoBar.Content>
                                                <StackPanel Margin="0,0,0,12" Spacing="8">
                                                    <TextBlock
                                                        FontFamily="Consolas"
                                                        IsTextSelectionEnabled="True"
                                                        Text="{x:Bind KeyChange, Mode=OneWay}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind HasKeyChange, Mode=OneWay}" />
                                                    <Button
                                                        AutomationProperties.AutomationId="SignInAgain"
                                                        Click="OnSignInAgainClick"
                                                        Content="{app:Localized Key=RemoteFoldersSignInAgain}"
                                                        Tag="{x:Bind Index}"
                                                        Visibility="{x:Bind CanSignInAgain, Mode=OneWay}" />
                                                    <Button
                                                        AutomationProperties.AutomationId="TrustKey"
                                                        Click="OnTrustKeyClick"
                                                        Content="{app:Localized Key=RemoteFoldersTrustKey}"
                                                        Tag="{x:Bind Index}"
                                                        Visibility="{x:Bind CanTrustKey, Mode=OneWay}" />
                                                </StackPanel>
                                            </InfoBar.Content>
                                        </InfoBar>
                                        <toolkit:SettingsCard Description="{x:Bind FolderText}" Header="{app:Localized Key=RemoteFoldersFolderOnPcHeader}" />
                                        <toolkit:SettingsCard
                                            Description="{app:Localized Key=RemoteFoldersConflictsDescription}"
                                            Header="{app:Localized Key=RemoteFoldersConflictsHeader}"
                                            Visibility="{x:Bind HasConflicts, Mode=OneWay}">
                                            <toolkit:SettingsCard.Content>
                                                <TextBlock
                                                    MaxWidth="320"
                                                    FlowDirection="LeftToRight"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind Conflicts, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </toolkit:SettingsCard.Content>
                                        </toolkit:SettingsCard>
                                        <toolkit:SettingsCard
                                            Description="{x:Bind NotMade, Mode=OneWay}"
                                            Header="{app:Localized Key=RemoteFoldersNotMadeHeader}"
                                            Visibility="{x:Bind HasNotMade, Mode=OneWay}" />
                                        <toolkit:SettingsCard
                                            Description="{x:Bind Hidden, Mode=OneWay}"
                                            Header="{app:Localized Key=RemoteFoldersHiddenHeader}"
                                            Visibility="{x:Bind HasHidden, Mode=OneWay}" />
                                    </StackPanel>
                                </controls:IconExpander.ItemsHeader>
                            </controls:IconExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:ButtonCard
                    Margin="0,16,0,0"
                    ButtonCommand="{x:Bind ViewModel.OpenRemoteFoldersCommand}"
                    ButtonContent="{app:Localized Key=RemoteFoldersOpenRemoteFolders}"
                    Description="{x:Bind ViewModel.RootFolderText}"
                    Glyph="&#xE8B7;"
                    Header="{app:Localized Key=RemoteFoldersWhereHeader}" />

                <controls:Note Margin="0,4,0,0" Message="{app:Localized Key=RemoteFoldersOffNote}" />

                <controls:PermissionsCard Description="{app:Localized Key=RemoteFoldersPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
