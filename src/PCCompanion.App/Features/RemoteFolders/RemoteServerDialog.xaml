<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PCCompanion.App.Features.RemoteFolders.RemoteServerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    CloseButtonText="{app:Localized Key=RemoteFoldersCancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind Editor.CanSave, Mode=OneWay}"
    PrimaryButtonText="{app:Localized Key=RemoteFoldersSave}"
    Style="{ThemeResource DefaultContentDialogStyle}"
    Title="{x:Bind Editor.Title}">

    <!-- Addresses, user names, paths and keys read left to right in every language. -->
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="440" Spacing="16">
            <controls:Note
                IsOpen="{x:Bind Editor.CannotConnectNow}"
                Message="{app:Localized Key=RemoteFoldersTurnOnToConnect}"
                Severity="Informational" />

            <StackPanel Spacing="4">
                <TextBox
                    x:Name="NameBox"
                    AutomationProperties.HelpText="{x:Bind Editor.NameProblem, Mode=OneWay}"
                    Header="{app:Localized Key=RemoteFoldersNameHeader}"
                    MaxLength="200"
                    PlaceholderText="{x:Bind Editor.NamePlaceholder, Mode=OneWay}"
                    Text="{x:Bind Editor.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Editor.NameProblem, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Editor.HasNameProblem, Mode=OneWay}" />
            </StackPanel>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBox
                        AutomationProperties.HelpText="{x:Bind Editor.AddressProblem, Mode=OneWay}"
                        FlowDirection="LeftToRight"
                        Header="{app:Localized Key=RemoteFoldersAddressHeader}"
                        InputScope="Url"
                        IsEnabled="{x:Bind Editor.IsNew}"
                        IsSpellCheckEnabled="False"
                        MaxLength="253"
                        PlaceholderText="nas.example.lan"
                        Text="{x:Bind Editor.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        controls:Announcement.IsLive="True"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Editor.AddressProblem, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Editor.HasAddressProblem, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBox
                        AutomationProperties.HelpText="{x:Bind Editor.PortProblem, Mode=OneWay}"
                        FlowDirection="LeftToRight"
                        Header="{app:Localized Key=RemoteFoldersPortHeader}"
                        InputScope="Number"
                        IsEnabled="{x:Bind Editor.IsNew}"
                        MaxLength="5"
                        Text="{x:Bind Editor.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        controls:Announcement.IsLive="True"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Editor.PortProblem, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Editor.HasPortProblem, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <TextBox
                FlowDirection="LeftToRight"
                Header="{app:Localized Key=RemoteFoldersUserNameHeader}"
                IsEnabled="{x:Bind Editor.IsNew}"
                IsSpellCheckEnabled="False"
                MaxLength="256"
                Text="{x:Bind Editor.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                MinWidth="200"
                Header="{app:Localized Key=RemoteFoldersSignInHeader}"
                ItemsSource="{x:Bind SignInChoices}"
                SelectedIndex="{x:Bind Editor.SignIn, Mode=TwoWay}" />

            <PasswordBox
                Header="{app:Localized Key=RemoteFoldersPasswordHeader}"
                Password="{x:Bind Editor.Password, Mode=TwoWay}"
                PlaceholderText="{x:Bind Editor.SecretPlaceholder, Mode=OneWay}"
                Visibility="{x:Bind Editor.UsesPassword, Mode=OneWay}" />

            <StackPanel Spacing="16" Visibility="{x:Bind Editor.UsesKey, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{app:Localized Key=RemoteFoldersKeyFileHeader}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            AutomationProperties.HelpText="{x:Bind Editor.KeyFileProblem, Mode=OneWay}"
                            AutomationProperties.Name="{app:Localized Key=RemoteFoldersKeyFileHeader}"
                            FlowDirection="LeftToRight"
                            IsSpellCheckEnabled="False"
                            PlaceholderText="C:\Users\ana\.ssh\id_ed25519"
                            Text="{x:Bind Editor.KeyFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="{app:Localized Key=RemoteFoldersBrowseKeyFileName}"
                            Click="OnBrowseKeyFileClick"
                            Content="{app:Localized Key=RemoteFoldersBrowse}" />
                    </Grid>
                    <TextBlock
                        controls:Announcement.IsLive="True"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Editor.KeyFileProblem, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Editor.HasKeyFileProblem, Mode=OneWay}" />
                </StackPanel>
                <PasswordBox
                    Header="{app:Localized Key=RemoteFoldersPassphraseHeader}"
                    Password="{x:Bind Editor.Passphrase, Mode=TwoWay}"
                    PlaceholderText="{x:Bind Editor.SecretPlaceholder, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        Click="OnConnectClick"
                        Content="{app:Localized Key=RemoteFoldersConnect}"
                        IsEnabled="{x:Bind Editor.CanConnect, Mode=OneWay}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="{app:Localized Key=RemoteFoldersConnecting}"
                        IsActive="{x:Bind Editor.IsConnecting, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Editor.ConnectHint, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Editor.HasConnectHint, Mode=OneWay}" />
                <TextBlock
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Editor.ConnectProblem, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Editor.HasConnectProblem, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind Editor.HasKey, Mode=OneWay}">
                <TextBlock Text="{app:Localized Key=RemoteFoldersKeyHeader}" />
                <TextBlock
                    AutomationProperties.Name="{x:Bind Editor.KeyText, Mode=OneWay}"
                    FlowDirection="LeftToRight"
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Editor.KeyText, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{app:Localized Key=RemoteFoldersKeyExplanation}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Editor.AsksToCheckKey, Mode=OneWay}" />
                <CheckBox
                    Content="{app:Localized Key=RemoteFoldersKeyChecked}"
                    IsChecked="{x:Bind Editor.KeyChecked, Mode=TwoWay}"
                    Visibility="{x:Bind Editor.AsksToCheckKey, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBox
                    AutomationProperties.HelpText="{x:Bind Editor.RemoteFolderProblem, Mode=OneWay}"
                    FlowDirection="LeftToRight"
                    Header="{app:Localized Key=RemoteFoldersRemoteFolderHeader}"
                    IsEnabled="{x:Bind Editor.IsNew}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{app:Localized Key=RemoteFoldersRemoteFolderPlaceholder}"
                    Text="{x:Bind Editor.RemoteFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Editor.RemoteFolderProblem, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Editor.HasRemoteFolderProblem, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
