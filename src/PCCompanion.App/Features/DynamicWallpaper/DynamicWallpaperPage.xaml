<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.DynamicWallpaper.DynamicWallpaperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.DynamicWallpaper"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <!-- A period's row, for the period's own picture and for each display's. -->
        <DataTemplate x:Key="PeriodTemplate" x:DataType="local:PeriodItem">
            <toolkit:SettingsCard
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                Description="{x:Bind Description, Mode=OneWay}"
                Header="{x:Bind Name, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{app:Localized Key=DynamicWallpaperInUse}"
                        Visibility="{x:Bind InUse, Mode=OneWay}" />
                    <TimePicker
                        AutomationProperties.AutomationId="Time"
                        AutomationProperties.Name="{x:Bind TimeName, Mode=OneWay}"
                        MinWidth="0"
                        SelectedTime="{x:Bind Time, Mode=TwoWay}"
                        Visibility="{x:Bind ShowsTime}" />
                    <!-- Pictures are never mirrored, and screen readers read the row's name instead. -->
                    <Border
                        Width="96"
                        Height="54"
                        AutomationProperties.AccessibilityView="Raw"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        FlowDirection="LeftToRight">
                        <Grid>
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="20"
                                Glyph="&#xE91B;"
                                Visibility="{x:Bind HasNoThumbnail, Mode=OneWay}" />
                            <Image
                                AutomationProperties.AccessibilityView="Raw"
                                Source="{x:Bind Thumbnail, Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <DropDownButton
                        AutomationProperties.AutomationId="Choose"
                        AutomationProperties.Name="{x:Bind ChooseName, Mode=OneWay}"
                        Content="{app:Localized Key=DynamicWallpaperChoose}"
                        IsEnabled="{x:Bind CanChoose, Mode=OneWay}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    Click="OnChoosePictureClick"
                                    Tag="{x:Bind}"
                                    Text="{app:Localized Key=DynamicWallpaperChoosePicture}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEB9F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnChooseFolderClick"
                                    Tag="{x:Bind}"
                                    Text="{app:Localized Key=DynamicWallpaperChooseFolder}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnChooseNoneClick"
                                    Tag="{x:Bind}"
                                    Text="{app:Localized Key=DynamicWallpaperChooseNone}"
                                    Visibility="{x:Bind CanBeNone}" />
                                <MenuFlyoutItem
                                    Click="OnChooseSameClick"
                                    Tag="{x:Bind}"
                                    Text="{app:Localized Key=DynamicWallpaperChooseSame}"
                                    Visibility="{x:Bind CanBeSame}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        AutomationProperties.AutomationId="Remove"
                        AutomationProperties.Name="{x:Bind RemoveName, Mode=OneWay}"
                        Click="OnRemoveClick"
                        IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind RemoveName, Mode=OneWay}"
                        Visibility="{x:Bind ShowsTime}">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </toolkit:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=DynamicWallpaperDescription}"
                    DrawnIcon="{x:Bind ViewModel.DrawnIcon}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=DynamicWallpaperName}" />

                <controls:Note
                    ButtonCommand="{x:Bind ViewModel.ResumeCommand}"
                    ButtonContent="{app:Localized Key=DynamicWallpaperResume}"
                    IsOpen="{x:Bind ViewModel.SteppedAside, Mode=OneWay}"
                    Message="{app:Localized Key=DynamicWallpaperSteppedAsideInfo}" />
                <controls:Note
                    IsOpen="{x:Bind ViewModel.Managed, Mode=OneWay}"
                    Message="{app:Localized Key=DynamicWallpaperManagedInfo}"
                    Severity="Warning" />
                <controls:Note
                    IsOpen="{x:Bind ViewModel.ExplorerNotAnswering, Mode=OneWay}"
                    Message="{app:Localized Key=DynamicWallpaperExplorerInfo}"
                    Severity="Warning" />
                <controls:Note IsOpen="{x:Bind ViewModel.RemoteSession, Mode=OneWay}" Message="{app:Localized Key=DynamicWallpaperRemoteInfo}" />
                <controls:Note
                    ButtonCommand="{x:Bind ViewModel.OpenBackgroundSettingsCommand}"
                    ButtonContent="{app:Localized Key=DynamicWallpaperOpenBackgroundSettings}"
                    IsOpen="{x:Bind ViewModel.SpotlightNote, Mode=OneWay}"
                    Message="{app:Localized Key=DynamicWallpaperSpotlightInfo}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=DynamicWallpaperChangeWithDescription}"
                    Glyph="&#xE823;"
                    Header="{app:Localized Key=DynamicWallpaperChangeWithHeader}"
                    ItemsSource="{x:Bind ViewModel.ChangeWithOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedChangeWith, Mode=TwoWay}" />

                <controls:Note IsOpen="{x:Bind ViewModel.IsWindowsMode, Mode=OneWay}" Message="{app:Localized Key=DynamicWallpaperWindowsModeInfo}" />

                <controls:IconExpander
                    Description="{x:Bind ViewModel.PicturesDescription, Mode=OneWay}"
                    Glyph="&#xE91B;"
                    Header="{x:Bind ViewModel.PicturesHeader, Mode=OneWay}"
                    IsExpanded="True"
                    ItemTemplate="{StaticResource PeriodTemplate}"
                    ItemsSource="{x:Bind ViewModel.Periods}">
                    <Button
                        AutomationProperties.AutomationId="AddTime"
                        Click="OnAddTimeClick"
                        Content="{app:Localized Key=DynamicWallpaperAddTime}"
                        IsEnabled="{x:Bind ViewModel.CanAddTime, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsTimes, Mode=OneWay}" />
                    <controls:IconExpander.ItemsHeader>
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.SamePicture, Mode=OneWay}"
                            Message="{app:Localized Key=DynamicWallpaperSamePictureInfo}"
                            Severity="Informational" />
                    </controls:IconExpander.ItemsHeader>
                </controls:IconExpander>

                <controls:SwitchCard
                    Description="{app:Localized Key=DynamicWallpaperEachDisplayDescription}"
                    Glyph="&#xE7F4;"
                    Header="{app:Localized Key=DynamicWallpaperEachDisplayHeader}"
                    IsOn="{x:Bind ViewModel.EachDisplay, Mode=TwoWay}"
                    IsSwitchEnabled="{x:Bind ViewModel.CanEachDisplay, Mode=OneWay}" />

                <!-- With a picture for each display, a group for each display. -->
                <ItemsControl
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Displays}"
                    Visibility="{x:Bind ViewModel.PicturesForEachDisplay, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DisplayGroup">
                            <controls:IconExpander
                                Description="{x:Bind Status, Mode=OneWay}"
                                Glyph="&#xE7F4;"
                                Header="{x:Bind Name}"
                                ItemTemplate="{StaticResource PeriodTemplate}"
                                ItemsSource="{x:Bind Periods}">
                                <Button
                                    AutomationProperties.AutomationId="RemoveDisplay"
                                    AutomationProperties.Name="{x:Bind RemoveName}"
                                    Click="OnRemoveDisplayClick"
                                    Content="{app:Localized Key=DynamicWallpaperRemoveDisplay}"
                                    Tag="{x:Bind}"
                                    Visibility="{x:Bind CanRemove, Mode=OneWay}" />
                            </controls:IconExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:ChoiceCard
                    Description="{app:Localized Key=DynamicWallpaperFitDescription}"
                    Glyph="&#xE9A6;"
                    Header="{app:Localized Key=DynamicWallpaperFitHeader}"
                    ItemsSource="{x:Bind ViewModel.FitOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedFit, Mode=TwoWay}" />

                <controls:IconExpander
                    Description="{app:Localized Key=DynamicWallpaperLocationDescription}"
                    Glyph="&#xE81D;"
                    Header="{app:Localized Key=DynamicWallpaperLocationHeader}"
                    IsExpanded="True"
                    Visibility="{x:Bind ViewModel.IsSun, Mode=OneWay}">
                    <ComboBox
                        MinWidth="200"
                        AutomationProperties.Name="{app:Localized Key=DynamicWallpaperLocationHeader}"
                        ItemsSource="{x:Bind ViewModel.LocationOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedLocation, Mode=TwoWay}" />
                    <controls:IconExpander.Items>
                        <toolkit:SettingsCard
                            Description="{app:Localized Key=DynamicWallpaperTimeZoneDescription}"
                            Header="{app:Localized Key=DynamicWallpaperTimeZoneHeader}"
                            Visibility="{x:Bind ViewModel.IsTimeZoneLocation, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.TimeZoneName, Mode=OneWay}" TextWrapping="Wrap" />
                        </toolkit:SettingsCard>
                        <!-- Coordinates are numbers, shown left to right in every language. -->
                        <toolkit:SettingsCard
                            Description="{app:Localized Key=DynamicWallpaperLatitudeDescription}"
                            Header="{app:Localized Key=DynamicWallpaperLatitude}"
                            Visibility="{x:Bind ViewModel.IsCoordinates, Mode=OneWay}">
                            <NumberBox
                                x:Name="LatitudeBox"
                                MinWidth="120"
                                AutomationProperties.AutomationId="Latitude"
                                AutomationProperties.Name="{app:Localized Key=DynamicWallpaperLatitude}"
                                FlowDirection="LeftToRight"
                                LargeChange="1"
                                Maximum="90"
                                Minimum="-90"
                                SmallChange="0.1"
                                Value="{x:Bind ViewModel.Latitude, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            Description="{app:Localized Key=DynamicWallpaperLongitudeDescription}"
                            Header="{app:Localized Key=DynamicWallpaperLongitude}"
                            Visibility="{x:Bind ViewModel.IsCoordinates, Mode=OneWay}">
                            <NumberBox
                                x:Name="LongitudeBox"
                                MinWidth="120"
                                AutomationProperties.AutomationId="Longitude"
                                AutomationProperties.Name="{app:Localized Key=DynamicWallpaperLongitude}"
                                FlowDirection="LeftToRight"
                                LargeChange="1"
                                Maximum="180"
                                Minimum="-180"
                                SmallChange="0.1"
                                Value="{x:Bind ViewModel.Longitude, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <controls:ButtonCard
                            ButtonCommand="{x:Bind ViewModel.UseMyLocationCommand}"
                            ButtonContent="{app:Localized Key=DynamicWallpaperUseMyLocation}"
                            Description="{app:Localized Key=DynamicWallpaperMyLocationDescription}"
                            Header="{app:Localized Key=DynamicWallpaperMyLocationHeader}"
                            IsWorking="{x:Bind ViewModel.Locating, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsCoordinates, Mode=OneWay}" />
                    </controls:IconExpander.Items>
                </controls:IconExpander>

                <controls:Note
                    ButtonCommand="{x:Bind ViewModel.OpenLocationSettingsCommand}"
                    ButtonContent="{app:Localized Key=DynamicWallpaperOpenLocationSettings}"
                    IsOpen="{x:Bind ViewModel.LocationDenied, Mode=OneWay}"
                    Message="{app:Localized Key=DynamicWallpaperLocationDeniedInfo}"
                    Severity="Warning" />
                <controls:Note
                    IsOpen="{x:Bind ViewModel.LocationFailed, Mode=OneWay}"
                    Message="{app:Localized Key=DynamicWallpaperLocationFailedInfo}"
                    Severity="Warning" />
                <controls:Note IsOpen="{x:Bind ViewModel.HasNoPlace, Mode=OneWay}" Message="{x:Bind ViewModel.NoPlaceInfo, Mode=OneWay}" />

                <controls:IconExpander
                    Description="{app:Localized Key=DynamicWallpaperTodayDescription}"
                    Glyph="&#xE787;"
                    Header="{app:Localized Key=DynamicWallpaperTodayHeader}"
                    ItemsSource="{x:Bind ViewModel.Today}"
                    Visibility="{x:Bind ViewModel.HasToday, Mode=OneWay}">
                    <controls:IconExpander.ItemsHeader>
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasTodayNote, Mode=OneWay}"
                            Message="{x:Bind ViewModel.TodayNote, Mode=OneWay}"
                            Severity="Informational" />
                    </controls:IconExpander.ItemsHeader>
                    <controls:IconExpander.ItemTemplate>
                        <DataTemplate x:DataType="local:TodayItem">
                            <toolkit:SettingsCard Header="{x:Bind Name}">
                                <TextBlock Text="{x:Bind Span}" />
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </controls:IconExpander.ItemTemplate>
                </controls:IconExpander>

                <controls:PermissionsCard Description="{app:Localized Key=DynamicWallpaperPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
