<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.MinimizeToTray.MinimizeToTrayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=MinimizeToTrayDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=MinimizeToTrayName}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=MinimizeToTrayShortcutDescription}"
                    Glyph="&#xE765;"
                    Header="{app:Localized Key=MinimizeToTrayShortcutHeader}"
                    ItemsSource="{x:Bind ViewModel.Shortcuts}"
                    SelectedItem="{x:Bind ViewModel.SelectedShortcut, Mode=TwoWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=MinimizeToTrayShiftMinimizeDescription}"
                    Glyph="&#xE921;"
                    Header="{app:Localized Key=MinimizeToTrayShiftMinimizeHeader}"
                    IsOn="{x:Bind ViewModel.ShiftMinimize, Mode=TwoWay}" />

                <controls:AppList
                    Apps="{x:Bind ViewModel.MinimizedApps}"
                    Description="{app:Localized Key=MinimizeToTrayAppsDescription}"
                    Header="{app:Localized Key=MinimizeToTrayAppsHeader}" />

                <controls:Note
                    Margin="0,16,0,0"
                    ButtonCommand="{x:Bind ViewModel.OpenTaskbarSettingsCommand}"
                    ButtonContent="{app:Localized Key=OpenTaskbarSettings}"
                    Message="{app:Localized Key=MinimizeToTrayHiddenIconsInfo}" />

                <controls:Note Message="{x:Bind ViewModel.CantGoInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=MinimizeToTrayPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
