<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.SystemMeters.SystemMetersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=SystemMetersDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=SystemMetersName}" />

                <controls:IconExpander
                    Description="{app:Localized Key=SystemMetersMetersDescription}"
                    Glyph="&#xE9D9;"
                    Header="{app:Localized Key=SystemMetersMetersHeader}"
                    IsExpanded="True">
                    <controls:IconExpander.Items>
                        <controls:SwitchCard
                            Description="{app:Localized Key=SystemMetersCpuDescription}"
                            Glyph="&#xE950;"
                            Header="{app:Localized Key=SystemMetersCpuHeader}"
                            IsOn="{x:Bind ViewModel.Cpu, Mode=TwoWay}" />
                        <controls:SwitchCard
                            Description="{app:Localized Key=SystemMetersMemoryDescription}"
                            Glyph="&#xE964;"
                            Header="{app:Localized Key=SystemMetersMemoryHeader}"
                            IsOn="{x:Bind ViewModel.Memory, Mode=TwoWay}" />
                        <controls:SwitchCard
                            Description="{app:Localized Key=SystemMetersNetworkDescription}"
                            Glyph="&#xE968;"
                            Header="{app:Localized Key=SystemMetersNetworkHeader}"
                            IsOn="{x:Bind ViewModel.Network, Mode=TwoWay}" />
                    </controls:IconExpander.Items>
                </controls:IconExpander>

                <controls:ChoiceCard
                    Description="{app:Localized Key=SystemMetersShowOnDescription}"
                    Glyph="&#xE7C4;"
                    Header="{app:Localized Key=SystemMetersShowOnHeader}"
                    ItemsSource="{x:Bind ViewModel.ShowOnOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedShowOn, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=SystemMetersLayoutDescription}"
                    Glyph="&#xE80A;"
                    Header="{app:Localized Key=SystemMetersLayoutHeader}"
                    IsEnabled="{x:Bind ViewModel.OnTaskbar, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.LayoutOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedLayout, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Glyph="&#xE790;"
                    Header="{app:Localized Key=SystemMetersIconsHeader}"
                    IsEnabled="{x:Bind ViewModel.OnTaskbar, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.IconsOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedIcons, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Glyph="&#xE916;"
                    Header="{app:Localized Key=SystemMetersIntervalHeader}"
                    ItemsSource="{x:Bind ViewModel.IntervalOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedInterval, Mode=TwoWay}" />

                <controls:Note Margin="0,16,0,0" Message="{app:Localized Key=SystemMetersTaskManagerInfo}" />

                <controls:Note
                    ButtonCommand="{x:Bind ViewModel.OpenTaskbarSettingsCommand}"
                    ButtonContent="{app:Localized Key=SystemMetersOpenTaskbarSettings}"
                    IsOpen="{x:Bind ViewModel.InNotificationArea, Mode=OneWay}"
                    Message="{app:Localized Key=SystemMetersHiddenIconsInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=SystemMetersPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
