<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.MiddleClickPaste.MiddleClickPastePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=MiddleClickPasteDescription}"
                    DrawnIcon="{x:Bind ViewModel.DrawnIcon}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=MiddleClickPasteName}" />

                <controls:IconCard
                    Description="{app:Localized Key=MiddleClickPasteHowDescription}"
                    Glyph="&#xE962;"
                    Header="{app:Localized Key=MiddleClickPasteHowHeader}" />

                <controls:AppList
                    Apps="{x:Bind ViewModel.ExcludedApps}"
                    Description="{app:Localized Key=MiddleClickPasteAppsDescription}"
                    Header="{app:Localized Key=MiddleClickPasteAppsHeader}" />

                <controls:Note Margin="0,16,0,0" Message="{app:Localized Key=MiddleClickPasteSharingInfo}" />

                <controls:Note Message="{x:Bind ViewModel.AdminInfo}" />

                <controls:Note Message="{app:Localized Key=MiddleClickPasteKeyboardInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=MiddleClickPastePermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
