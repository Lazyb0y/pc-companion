<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.LauncherActions.LauncherActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.LauncherActions"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=LauncherActionsDescription}"
                    DrawnIcon="{x:Bind ViewModel.DrawnIcon}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=LauncherActionsName}" />

                <controls:SwitchCard
                    AutomationProperties.AutomationId="ShowInStart"
                    Description="{app:Localized Key=LauncherActionsShowInStartDescription}"
                    Glyph="&#xE721;"
                    Header="{app:Localized Key=LauncherActionsShowInStartHeader}"
                    IsOn="{x:Bind ViewModel.ShowInStart, Mode=TwoWay}" />

                <controls:IconExpander
                    AutomationProperties.AutomationId="FeaturesInStart"
                    Description="{app:Localized Key=LauncherActionsFeaturesDescription}"
                    Glyph="&#xE71D;"
                    Header="{app:Localized Key=LauncherActionsFeaturesHeader}"
                    IsEnabled="{x:Bind ViewModel.ShowInStart, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.FeaturesInStart}">
                    <controls:IconExpander.ItemTemplate>
                        <DataTemplate x:DataType="local:FeatureInStartItem">
                            <toolkit:SettingsCard Description="{x:Bind Actions}" Header="{x:Bind Name}">
                                <ToggleSwitch AutomationProperties.Name="{x:Bind Name}" IsOn="{x:Bind IsOn, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </controls:IconExpander.ItemTemplate>
                </controls:IconExpander>

                <StackPanel Margin="0,24,0,4" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=LauncherActionsActionsHeader}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{app:Localized Key=LauncherActionsActionsDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ItemsControl
                    AutomationProperties.AutomationId="LauncherActionsList"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Actions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:LauncherActionItem">
                            <toolkit:SettingsCard Description="{x:Bind FeatureName}" Header="{x:Bind Name}">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE768;" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <Button
                                    AutomationProperties.Name="{x:Bind CopyName}"
                                    Command="{x:Bind Copy}"
                                    Content="{app:Localized Key=LauncherActionsCopyCommand}" />
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="0,8,0,0"
                    controls:Announcement.IsLive="True"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Copied, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <controls:Note
                    Margin="0,8,0,0"
                    IsOpen="{x:Bind ViewModel.HasOnlyItsOwnActions}"
                    Message="{app:Localized Key=LauncherActionsMoreActionsInfo}" />

                <controls:Note
                    Margin="0,8,0,0"
                    ButtonCommand="{x:Bind ViewModel.OpenShortcutsCommand}"
                    ButtonContent="{app:Localized Key=LauncherActionsOpenShortcuts}"
                    Message="{app:Localized Key=LauncherActionsWindowInFrontInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=LauncherActionsPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
