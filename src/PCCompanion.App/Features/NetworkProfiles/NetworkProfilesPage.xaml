<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.NetworkProfiles.NetworkProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.NetworkProfiles"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=NetworkProfilesDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=NetworkProfilesName}" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.IsManaged, Mode=OneWay}"
                    Message="{app:Localized Key=NetworkProfilesManagedInfo}"
                    Severity="Warning" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.HasUseProblem, Mode=OneWay}"
                    Message="{x:Bind ViewModel.UseProblem, Mode=OneWay}"
                    Severity="Error" />

                <Grid Margin="0,24,0,4" ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=NetworkProfilesProfilesHeader}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{app:Localized Key=NetworkProfilesProfilesDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            AutomationProperties.Name="{app:Localized Key=NetworkProfilesAddCurrent}"
                            Click="OnAddCurrentClick"
                            Content="{app:Localized Key=NetworkProfilesAddCurrent}"
                            IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}" />
                        <Button
                            AutomationProperties.Name="{app:Localized Key=NetworkProfilesAddProfile}"
                            Click="OnAddClick"
                            IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Text="{app:Localized Key=NetworkProfilesAddProfile}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{app:Localized Key=NetworkProfilesNoProfiles}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoProfiles, Mode=OneWay}" />

                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Profiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:NetworkProfileItem">
                            <toolkit:SettingsCard Description="{x:Bind Summary}" Header="{x:Bind Name}">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE774;" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{app:Localized Key=NetworkProfilesInUse}"
                                        Visibility="{x:Bind IsInUse}" />
                                    <Button
                                        AutomationProperties.Name="{x:Bind UseName}"
                                        Click="OnUseClick"
                                        Content="{app:Localized Key=NetworkProfilesUse}"
                                        IsEnabled="{x:Bind CanUse}"
                                        Tag="{x:Bind Index}"
                                        Visibility="{x:Bind IsNotInUse}" />
                                    <Button
                                        AutomationProperties.Name="{x:Bind EditName}"
                                        Click="OnEditClick"
                                        Content="{app:Localized Key=NetworkProfilesEdit}"
                                        Tag="{x:Bind Index}" />
                                    <Button AutomationProperties.Name="{x:Bind MoreName}" ToolTipService.ToolTip="{x:Bind MoreName}">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    Click="OnMoveUpClick"
                                                    IsEnabled="{x:Bind CanMoveUp}"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=NetworkProfilesMoveUp}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74A;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Click="OnMoveDownClick"
                                                    IsEnabled="{x:Bind CanMoveDown}"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=NetworkProfilesMoveDown}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74B;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="OnDeleteClick"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=NetworkProfilesDelete}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:Note Margin="0,16,0,0" Message="{app:Localized Key=NetworkProfilesInfo}" />

                <controls:ButtonCard
                    ButtonCommand="{x:Bind ViewModel.OpenProxySettingsCommand}"
                    ButtonContent="{app:Localized Key=NetworkProfilesOpenWindowsSettings}"
                    Description="{app:Localized Key=NetworkProfilesWindowsSettingsDescription}"
                    Glyph="&#xE713;"
                    Header="{app:Localized Key=NetworkProfilesWindowsSettingsHeader}" />

                <controls:PermissionsCard Description="{app:Localized Key=NetworkProfilesPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
