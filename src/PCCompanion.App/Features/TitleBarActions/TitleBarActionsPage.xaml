<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.TitleBarActions.TitleBarActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=TitleBarActionsDescription}"
                    DrawnIcon="{x:Bind ViewModel.DrawnIcon}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=TitleBarActionsName}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=TitleBarActionsMiddleClickDescription}"
                    Glyph="&#xE962;"
                    Header="{app:Localized Key=TitleBarActionsMiddleClickHeader}"
                    ItemsSource="{x:Bind ViewModel.ClickActions}"
                    SelectedItem="{x:Bind ViewModel.SelectedMiddleClick, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=TitleBarActionsShiftMiddleClickDescription}"
                    Glyph="&#xE962;"
                    Header="{app:Localized Key=TitleBarActionsShiftMiddleClickHeader}"
                    ItemsSource="{x:Bind ViewModel.ClickActions}"
                    SelectedItem="{x:Bind ViewModel.SelectedShiftMiddleClick, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=TitleBarActionsControlMiddleClickDescription}"
                    Glyph="&#xE962;"
                    Header="{app:Localized Key=TitleBarActionsControlMiddleClickHeader}"
                    ItemsSource="{x:Bind ViewModel.ClickActions}"
                    SelectedItem="{x:Bind ViewModel.SelectedControlMiddleClick, Mode=TwoWay}" />

                <controls:Note IsOpen="{x:Bind ViewModel.NeedsFeatures, Mode=OneWay}" Message="{app:Localized Key=TitleBarActionsNeedsFeaturesInfo}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=TitleBarActionsWheelDescription}"
                    Glyph="&#xE962;"
                    Header="{app:Localized Key=TitleBarActionsWheelHeader}"
                    ItemsSource="{x:Bind ViewModel.WheelActions}"
                    SelectedItem="{x:Bind ViewModel.SelectedWheel, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=TitleBarActionsControlWheelDescription}"
                    Glyph="&#xE962;"
                    Header="{app:Localized Key=TitleBarActionsControlWheelHeader}"
                    ItemsSource="{x:Bind ViewModel.WheelActions}"
                    SelectedItem="{x:Bind ViewModel.SelectedControlWheel, Mode=TwoWay}" />

                <controls:AppList
                    Apps="{x:Bind ViewModel.ExcludedApps}"
                    Description="{app:Localized Key=TitleBarActionsAppsDescription}"
                    Header="{app:Localized Key=TitleBarActionsAppsHeader}" />

                <controls:Note Margin="0,16,0,0" Message="{x:Bind ViewModel.LeftOutInfo}" />

                <controls:Note Message="{app:Localized Key=TitleBarActionsKeyboardInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=TitleBarActionsPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
