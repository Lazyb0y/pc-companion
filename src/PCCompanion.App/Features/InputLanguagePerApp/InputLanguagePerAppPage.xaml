<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.InputLanguagePerApp.InputLanguagePerAppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=InputLanguagePerAppDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=InputLanguagePerAppName}" />

                <controls:Note
                    ButtonCommand="{x:Bind ViewModel.OpenLanguageSettingsCommand}"
                    ButtonContent="{app:Localized Key=InputLanguagePerAppOpenLanguageSettings}"
                    IsOpen="{x:Bind ViewModel.FewInputMethods, Mode=OneWay}"
                    Message="{app:Localized Key=InputLanguagePerAppFewInputMethodsInfo}" />

                <controls:AppList
                    Apps="{x:Bind ViewModel.Apps}"
                    Description="{app:Localized Key=InputLanguagePerAppAppsDescription}"
                    Header="{app:Localized Key=InputLanguagePerAppAppsHeader}" />

                <controls:ChoiceCard
                    Margin="0,16,0,0"
                    Description="{app:Localized Key=InputLanguagePerAppOtherAppsDescription}"
                    Glyph="&#xE71D;"
                    Header="{app:Localized Key=InputLanguagePerAppOtherAppsHeader}"
                    ItemsSource="{x:Bind ViewModel.OtherAppsOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedOtherApps, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=InputLanguagePerAppOneLanguageDescription}"
                    Glyph="&#xE765;"
                    Header="{app:Localized Key=InputLanguagePerAppOneLanguageHeader}"
                    ItemsSource="{x:Bind ViewModel.InputMethods, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedOneLanguage, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.UsesOneLanguage, Mode=OneWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=InputLanguagePerAppShowNoticeDescription}"
                    Glyph="&#xE8BD;"
                    Header="{app:Localized Key=InputLanguagePerAppShowNoticeHeader}"
                    IsOn="{x:Bind ViewModel.ShowNotice, Mode=TwoWay}" />

                <controls:ButtonCard
                    ButtonCommand="{x:Bind ViewModel.OpenTypingSettingsCommand}"
                    ButtonContent="{app:Localized Key=InputLanguagePerAppOpenTypingSettings}"
                    Description="{x:Bind ViewModel.WindowsSettingInfo}"
                    Glyph="&#xE713;"
                    Header="{app:Localized Key=InputLanguagePerAppWindowsSettingHeader}" />

                <controls:Note Margin="0,16,0,0" Message="{x:Bind ViewModel.AdministratorInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=InputLanguagePerAppPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
