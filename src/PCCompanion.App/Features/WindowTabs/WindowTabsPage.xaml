<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.WindowTabs.WindowTabsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=WindowTabsDescription}"
                    DrawnIcon="{x:Bind ViewModel.DrawnIcon}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=WindowTabsName}" />

                <controls:IconCard
                    Description="{app:Localized Key=WindowTabsMakingDescription}"
                    Glyph="&#xE7C4;"
                    Header="{app:Localized Key=WindowTabsMakingHeader}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=WindowTabsGroupByDroppingDescription}"
                    Glyph="&#xE7C2;"
                    Header="{app:Localized Key=WindowTabsGroupByDroppingHeader}"
                    IsOn="{x:Bind ViewModel.GroupByDropping, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=WindowTabsSwitchDescription}"
                    Glyph="&#xE765;"
                    Header="{app:Localized Key=WindowTabsSwitchHeader}"
                    ItemsSource="{x:Bind ViewModel.SwitchOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSwitch, Mode=TwoWay}" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.ShortcutRefused, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ShortcutRefusedInfo, Mode=OneWay}"
                    Severity="Warning" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=WindowTabsGroupKeysDescription}"
                    Glyph="&#xE765;"
                    Header="{app:Localized Key=WindowTabsGroupKeysHeader}"
                    ItemsSource="{x:Bind ViewModel.GroupOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.GroupShortcutRefused, Mode=OneWay}"
                    Message="{x:Bind ViewModel.GroupShortcutRefusedInfo}"
                    Severity="Warning" />

                <controls:Note Margin="0,16,0,0" Message="{x:Bind ViewModel.CantBeTabsInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=WindowTabsPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
