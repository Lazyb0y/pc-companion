<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.DriveActions.DriveActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.DriveActions"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=DriveActionsDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=DriveActionsName}" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.IsPaused}"
                    Message="{app:Localized Key=DriveActionsAdministratorInfo}"
                    Severity="Warning" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.IsNotAnswering, Mode=OneWay}"
                    Message="{app:Localized Key=DriveActionsNotAnsweringInfo}"
                    Severity="Warning" />

                <controls:Note
                    ButtonCommand="{x:Bind ViewModel.OpenAutoPlaySettingsCommand}"
                    ButtonContent="{app:Localized Key=DriveActionsOpenAutoPlaySettings}"
                    Message="{app:Localized Key=DriveActionsAutoPlayInfo}" />

                <Grid Margin="0,24,0,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=DriveActionsDrivesHeader}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{app:Localized Key=DriveActionsDrivesDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="AddDriveButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="{app:Localized Key=DriveActionsAddDrive}"
                        Click="OnAddDriveClick"
                        IsEnabled="{x:Bind ViewModel.CanAddDrive, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="{app:Localized Key=DriveActionsAddDrive}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <controls:Note
                    IsOpen="{x:Bind ViewModel.HasNote, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Note, Mode=OneWay}"
                    Severity="Warning" />

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{app:Localized Key=DriveActionsNoDrives}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoDrives, Mode=OneWay}" />

                <ItemsControl
                    x:Name="DriveList"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Drives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DriveItem">
                            <controls:IconExpander
                                Description="{x:Bind Status, Mode=OneWay}"
                                Glyph="{x:Bind Glyph}"
                                Header="{x:Bind Name}"
                                IsExpanded="True"
                                ItemsSource="{x:Bind Actions}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="RunNow"
                                        AutomationProperties.Name="{x:Bind RunNowName}"
                                        Click="OnRunNowClick"
                                        Content="{app:Localized Key=DriveActionsRunNow}"
                                        IsEnabled="{x:Bind CanRunNow, Mode=OneWay}"
                                        Tag="{x:Bind Index}"
                                        Visibility="{x:Bind IsNotRunning, Mode=OneWay}" />
                                    <Button
                                        AutomationProperties.AutomationId="Stop"
                                        AutomationProperties.Name="{x:Bind StopName}"
                                        Click="OnStopClick"
                                        Content="{app:Localized Key=DriveActionsStop}"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                                    <Button
                                        AutomationProperties.AutomationId="DriveMore"
                                        AutomationProperties.Name="{x:Bind MoreName}"
                                        Tag="{x:Bind Index}"
                                        ToolTipService.ToolTip="{x:Bind MoreName}">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    Click="OnRenameClick"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=DriveActionsRename}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8AC;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Click="OnRemoveDriveClick"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=DriveActionsRemove}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <controls:IconExpander.ItemsHeader>
                                    <StackPanel>
                                        <InfoBar
                                            IsClosable="False"
                                            IsOpen="{x:Bind HasProblem}"
                                            Message="{x:Bind Problem}"
                                            Severity="Error" />
                                        <InfoBar
                                            IsClosable="False"
                                            IsOpen="{x:Bind HasLookAlike, Mode=OneWay}"
                                            Message="{x:Bind LookAlike, Mode=OneWay}"
                                            Severity="Warning">
                                            <InfoBar.ActionButton>
                                                <Button
                                                    AutomationProperties.AutomationId="UseThisDrive"
                                                    Click="OnUseThisDriveClick"
                                                    Content="{app:Localized Key=DriveActionsUseThisDrive}"
                                                    Tag="{x:Bind Index}" />
                                            </InfoBar.ActionButton>
                                        </InfoBar>
                                        <InfoBar
                                            IsClosable="False"
                                            IsOpen="{x:Bind HasNotRecognized, Mode=OneWay}"
                                            Message="{x:Bind NotRecognized, Mode=OneWay}"
                                            Severity="Warning">
                                            <InfoBar.ActionButton>
                                                <Button
                                                    AutomationProperties.AutomationId="AddAgain"
                                                    Click="OnAddAgainClick"
                                                    Content="{app:Localized Key=DriveActionsAddAgain}"
                                                    Tag="{x:Bind Index}" />
                                            </InfoBar.ActionButton>
                                        </InfoBar>
                                        <InfoBar
                                            IsClosable="False"
                                            IsOpen="{x:Bind ReceivesBackups}"
                                            Message="{app:Localized Key=DriveActionsBitLockerInfo}"
                                            Severity="Informational" />
                                        <toolkit:SettingsCard Header="{app:Localized Key=DriveActionsWhenConnectedHeader}">
                                            <ComboBox
                                                MinWidth="180"
                                                AutomationProperties.Name="{x:Bind WhenConnectedName}"
                                                ItemsSource="{x:Bind WhenConnectedChoices}"
                                                PlaceholderText="{app:Localized Key=DriveActionsWhenUnknown}"
                                                SelectedIndex="{x:Bind WhenConnected}"
                                                SelectionChanged="OnWhenConnectedChanged"
                                                Tag="{x:Bind Index}" />
                                        </toolkit:SettingsCard>
                                        <toolkit:SettingsCard Description="{app:Localized Key=DriveActionsEjectDescription}" Header="{app:Localized Key=DriveActionsEjectHeader}">
                                            <ToggleSwitch
                                                AutomationProperties.Name="{x:Bind EjectName}"
                                                IsOn="{x:Bind EjectWhenDone}"
                                                OffContent=""
                                                OnContent=""
                                                Tag="{x:Bind Index}"
                                                Toggled="OnEjectToggled" />
                                        </toolkit:SettingsCard>
                                        <toolkit:SettingsCard Description="{app:Localized Key=DriveActionsActionsDescription}" Header="{app:Localized Key=DriveActionsActionsHeader}">
                                            <Button
                                                AutomationProperties.AutomationId="AddAction"
                                                AutomationProperties.Name="{x:Bind AddActionName}"
                                                Click="OnAddActionClick"
                                                Content="{app:Localized Key=DriveActionsAddAction}"
                                                IsEnabled="{x:Bind CanAddAction}"
                                                Tag="{x:Bind Index}" />
                                        </toolkit:SettingsCard>
                                        <toolkit:SettingsCard Header="{app:Localized Key=DriveActionsNoActions}" Visibility="{x:Bind HasNoActions}" />
                                    </StackPanel>
                                </controls:IconExpander.ItemsHeader>
                                <controls:IconExpander.ItemTemplate>
                                    <DataTemplate x:DataType="local:DriveActionItem">
                                        <toolkit:SettingsCard Description="{x:Bind Summary}" Header="{x:Bind Name}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    AutomationProperties.AutomationId="ActionEdit"
                                                    AutomationProperties.Name="{x:Bind EditName}"
                                                    Click="OnEditActionClick"
                                                    Content="{app:Localized Key=DriveActionsEdit}"
                                                    IsEnabled="{x:Bind CanEdit}"
                                                    Tag="{x:Bind Tag}" />
                                                <Button
                                                    AutomationProperties.AutomationId="ActionMore"
                                                    AutomationProperties.Name="{x:Bind MoreName}"
                                                    Tag="{x:Bind Tag}"
                                                    ToolTipService.ToolTip="{x:Bind MoreName}">
                                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE712;" />
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem
                                                                Click="OnMoveUpClick"
                                                                IsEnabled="{x:Bind CanMoveUp}"
                                                                Tag="{x:Bind Tag}"
                                                                Text="{app:Localized Key=DriveActionsMoveUp}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74A;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem
                                                                Click="OnMoveDownClick"
                                                                IsEnabled="{x:Bind CanMoveDown}"
                                                                Tag="{x:Bind Tag}"
                                                                Text="{app:Localized Key=DriveActionsMoveDown}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74B;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem
                                                                Click="OnRemoveActionClick"
                                                                Tag="{x:Bind Tag}"
                                                                Text="{app:Localized Key=DriveActionsRemove}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </toolkit:SettingsCard>
                                    </DataTemplate>
                                </controls:IconExpander.ItemTemplate>
                            </controls:IconExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,24,0,4" ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=DriveActionsHistoryHeader}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{app:Localized Key=DriveActionsHistoryDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="RefreshHistoryButton"
                            Click="OnRefreshHistoryClick"
                            Content="{app:Localized Key=DriveActionsHistoryRefresh}" />
                        <Button Click="OnOpenRecycleBinClick" Content="{app:Localized Key=DriveActionsOpenRecycleBin}" />
                        <Button
                            Click="OnClearHistoryClick"
                            Content="{app:Localized Key=DriveActionsClearHistory}"
                            IsEnabled="{x:Bind ViewModel.History.CanClear, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <controls:Note
                    IsOpen="{x:Bind ViewModel.History.HasNote, Mode=OneWay}"
                    Message="{x:Bind ViewModel.History.Note, Mode=OneWay}"
                    Severity="Informational" />

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.History.Status, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.History.HasStatus, Mode=OneWay}" />

                <ItemsControl
                    x:Name="HistoryList"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.History.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:RunItem">
                            <controls:IconExpander
                                Description="{x:Bind Description}"
                                Glyph="&#xE81C;"
                                Header="{x:Bind Name}"
                                ItemsSource="{x:Bind Files}">
                                <Button
                                    AutomationProperties.AutomationId="UndoRun"
                                    AutomationProperties.Name="{x:Bind UndoName}"
                                    Click="OnUndoRunClick"
                                    Content="{app:Localized Key=DriveActionsUndo}"
                                    Tag="{x:Bind Index}"
                                    Visibility="{x:Bind CanUndo}" />
                                <controls:IconExpander.ItemTemplate>
                                    <DataTemplate x:DataType="local:RunFileItem">
                                        <toolkit:SettingsCard Description="{x:Bind What}">
                                            <toolkit:SettingsCard.Header>
                                                <TextBlock FlowDirection="LeftToRight" Text="{x:Bind Path}" TextWrapping="Wrap" />
                                            </toolkit:SettingsCard.Header>
                                            <Button
                                                AutomationProperties.AutomationId="UndoFile"
                                                AutomationProperties.Name="{x:Bind UndoName}"
                                                Click="OnUndoFileClick"
                                                Content="{app:Localized Key=DriveActionsUndo}"
                                                Tag="{x:Bind Tag}"
                                                Visibility="{x:Bind CanUndo}" />
                                        </toolkit:SettingsCard>
                                    </DataTemplate>
                                </controls:IconExpander.ItemTemplate>
                            </controls:IconExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button
                    Margin="0,8,0,0"
                    Click="OnShowMoreClick"
                    Content="{app:Localized Key=DriveActionsHistoryShowMore}"
                    Visibility="{x:Bind ViewModel.History.HasMore, Mode=OneWay}" />

                <controls:PermissionsCard Margin="0,24,0,0" Description="{app:Localized Key=DriveActionsPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
