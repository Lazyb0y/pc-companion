<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.AppWindows.AppWindowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=AppWindowsDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=AppWindowsName}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=AppWindowsShortcutDescription}"
                    Glyph="&#xE765;"
                    Header="{app:Localized Key=AppWindowsShortcutHeader}"
                    ItemsSource="{x:Bind ViewModel.Shortcuts}"
                    SelectedItem="{x:Bind ViewModel.SelectedShortcut, Mode=TwoWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=AppWindowsMinimizedDescription}"
                    Glyph="&#xE921;"
                    Header="{app:Localized Key=AppWindowsMinimizedHeader}"
                    IsOn="{x:Bind ViewModel.IncludeMinimized, Mode=TwoWay}" />

                <InfoBar
                    Margin="0,16,0,0"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{app:Localized Key=AppWindowsShortcutInfo}"
                    Severity="Informational" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.AdministratorInfo}"
                    Severity="Informational" />

                <toolkit:SettingsCard Description="{app:Localized Key=AppWindowsPermissions}" Header="{app:Localized Key=FeaturePermissionsHeader}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
