<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.AppWindows.AppWindowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:local="using:PCCompanion.App.Features.AppWindows"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- Laid out like the other feature pages: a column in the middle of the page, at most 1,000 pixels wide. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel MaxWidth="1072" Padding="36,24" Spacing="4">
                <Grid Margin="0,0,0,20" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Top"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="32"
                        Glyph="{x:Bind local:AppWindowsViewModel.Glyph}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{app:Localized Key=AppWindowsName}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{app:Localized Key=AppWindowsDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{app:Localized Key=AppWindowsName}"
                        IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}" />
                </Grid>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Message="{app:Localized Key=FeatureSaveFailed}"
                    Severity="Error" />

                <toolkit:SettingsCard Description="{app:Localized Key=AppWindowsShortcutDescription}" Header="{app:Localized Key=AppWindowsShortcutHeader}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        MinWidth="200"
                        AutomationProperties.Name="{app:Localized Key=AppWindowsShortcutHeader}"
                        ItemsSource="{x:Bind ViewModel.Shortcuts}"
                        SelectedItem="{x:Bind ViewModel.SelectedShortcut, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ShortcutOption">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="{app:Localized Key=AppWindowsMinimizedDescription}" Header="{app:Localized Key=AppWindowsMinimizedHeader}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE921;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch AutomationProperties.Name="{app:Localized Key=AppWindowsMinimizedHeader}" IsOn="{x:Bind ViewModel.IncludeMinimized, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <InfoBar
                    Margin="0,16,0,0"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{app:Localized Key=AppWindowsShortcutInfo}"
                    Severity="Informational" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.AdministratorInfo}"
                    Severity="Informational" />

                <toolkit:SettingsCard Description="{app:Localized Key=AppWindowsPermissions}" Header="{app:Localized Key=FeaturePermissionsHeader}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
