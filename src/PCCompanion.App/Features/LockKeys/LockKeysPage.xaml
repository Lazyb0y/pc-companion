<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.LockKeys.LockKeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.LockKeys">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=LockKeysDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=LockKeysName}" />

                <controls:IconExpander
                    Description="{app:Localized Key=LockKeysKeysDescription}"
                    Glyph="&#xE765;"
                    Header="{app:Localized Key=LockKeysKeysHeader}"
                    IsExpanded="True">
                    <controls:IconExpander.Items>
                        <controls:SwitchCard
                            Glyph="&#xE8D2;"
                            Header="{app:Localized Key=LockKeysCapsLockHeader}"
                            IsOn="{x:Bind ViewModel.CapsLock, Mode=TwoWay}" />
                        <controls:SwitchCard
                            Glyph="&#xE8EF;"
                            Header="{app:Localized Key=LockKeysNumLockHeader}"
                            IsOn="{x:Bind ViewModel.NumLock, Mode=TwoWay}" />
                        <controls:SwitchCard
                            Description="{app:Localized Key=LockKeysScrollLockDescription}"
                            Glyph="&#xEC8F;"
                            Header="{app:Localized Key=LockKeysScrollLockHeader}"
                            IsOn="{x:Bind ViewModel.ScrollLock, Mode=TwoWay}" />
                        <controls:SwitchCard
                            Description="{app:Localized Key=LockKeysShowWhenOffDescription}"
                            Glyph="&#xE785;"
                            Header="{app:Localized Key=LockKeysShowWhenOffHeader}"
                            IsOn="{x:Bind ViewModel.ShowWhenOff, Mode=TwoWay}" />
                    </controls:IconExpander.Items>
                </controls:IconExpander>

                <controls:Note IsOpen="{x:Bind ViewModel.NoKeyChosen, Mode=OneWay}" Message="{app:Localized Key=LockKeysNoKeyInfo}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=LockKeysPositionDescription}"
                    Glyph="&#xE7F4;"
                    Header="{app:Localized Key=LockKeysPositionHeader}"
                    ItemsSource="{x:Bind ViewModel.PositionOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedPosition, Mode=TwoWay}" />

                <controls:SliderCard
                    Description="{app:Localized Key=LockKeysDurationDescription}"
                    Glyph="&#xE916;"
                    Header="{app:Localized Key=LockKeysDurationHeader}"
                    Maximum="{x:Bind local:LockKeysViewModel.MaximumDuration}"
                    Minimum="{x:Bind local:LockKeysViewModel.MinimumDuration}"
                    StepFrequency="500"
                    Value="{x:Bind ViewModel.Duration, Mode=TwoWay}"
                    ValueText="{x:Bind ViewModel.DurationText, Mode=OneWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=LockKeysFullScreenDescription}"
                    Glyph="&#xE740;"
                    Header="{app:Localized Key=LockKeysFullScreenHeader}"
                    IsOn="{x:Bind ViewModel.IgnoreFullScreenApps, Mode=TwoWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=LockKeysBadgeDescription}"
                    Glyph="&#xE72E;"
                    Header="{app:Localized Key=LockKeysBadgeHeader}"
                    IsOn="{x:Bind ViewModel.KeepCapsLockBadge, Mode=TwoWay}" />

                <controls:ButtonCard
                    ButtonCommand="{x:Bind ViewModel.OpenKeyboardSettingsCommand}"
                    ButtonContent="{app:Localized Key=LockKeysOpenKeyboardSettings}"
                    Description="{app:Localized Key=LockKeysSoundsDescription}"
                    Glyph="&#xE776;"
                    Header="{app:Localized Key=LockKeysSoundsHeader}" />

                <controls:PermissionsCard Description="{app:Localized Key=LockKeysPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
