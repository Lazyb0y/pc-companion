<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.EndApp.EndAppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=EndAppDescription}"
                    DrawnIcon="{x:Bind ViewModel.DrawnIcon}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=EndAppName}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=EndAppShortcutDescription}"
                    Glyph="&#xE765;"
                    Header="{app:Localized Key=EndAppShortcutHeader}"
                    ItemsSource="{x:Bind ViewModel.Shortcuts}"
                    SelectedItem="{x:Bind ViewModel.SelectedShortcut, Mode=TwoWay}" />

                <controls:IconCard
                    Description="{app:Localized Key=EndAppChoosingDescription}"
                    Glyph="&#xE7C9;"
                    Header="{app:Localized Key=EndAppChoosingHeader}" />

                <controls:Note Margin="0,16,0,0" Message="{x:Bind ViewModel.CantEndInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=EndAppPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
