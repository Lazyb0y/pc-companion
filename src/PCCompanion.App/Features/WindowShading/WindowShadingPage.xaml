<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.WindowShading.WindowShadingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=WindowShadingDescription}"
                    DrawnIcon="{x:Bind ViewModel.DrawnIcon}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=WindowShadingName}" />

                <controls:ButtonCard
                    ButtonCommand="{x:Bind ViewModel.OpenShortcutsCommand}"
                    ButtonContent="{app:Localized Key=ShortcutsAndMouseButtonsName}"
                    Description="{app:Localized Key=WindowShadingHowText}"
                    Glyph="&#xE82F;"
                    Header="{app:Localized Key=WindowShadingHowHeader}"
                    IsSecondButtonShown="True"
                    SecondButtonCommand="{x:Bind ViewModel.OpenTitleBarActionsCommand}"
                    SecondButtonContent="{app:Localized Key=TitleBarActionsName}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=WindowShadingKeepOnTopDescription}"
                    Glyph="&#xE718;"
                    Header="{app:Localized Key=WindowShadingKeepOnTopHeader}"
                    IsOn="{x:Bind ViewModel.KeepOnTop, Mode=TwoWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=WindowShadingHoverDescription}"
                    Glyph="&#xE962;"
                    Header="{app:Localized Key=WindowShadingHoverHeader}"
                    IsOn="{x:Bind ViewModel.Hover, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Glyph="&#xE916;"
                    Header="{app:Localized Key=WindowShadingRollDownAfter}"
                    IsEnabled="{x:Bind ViewModel.Hover, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.RollDownDelays}"
                    SelectedItem="{x:Bind ViewModel.SelectedRollDownDelay, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Glyph="&#xE916;"
                    Header="{app:Localized Key=WindowShadingRollUpAfter}"
                    IsEnabled="{x:Bind ViewModel.Hover, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.RollUpDelays}"
                    SelectedItem="{x:Bind ViewModel.SelectedRollUpDelay, Mode=TwoWay}" />

                <controls:Note Margin="0,16,0,0" Message="{app:Localized Key=WindowShadingLeftOutInfo}" />

                <controls:Note Margin="0,8,0,0" Message="{x:Bind ViewModel.AdministratorInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=WindowShadingPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
