<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.DisplayProfiles.DisplayProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.DisplayProfiles"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=DisplayProfilesDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=DisplayProfilesName}" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.IsRemote, Mode=OneWay}"
                    Message="{app:Localized Key=DisplayProfilesRemoteInfo}"
                    Severity="Warning" />

                <controls:Note
                    IsOpen="{x:Bind ViewModel.HasUseProblem, Mode=OneWay}"
                    Message="{x:Bind ViewModel.UseProblem, Mode=OneWay}"
                    Severity="Error" />

                <Grid Margin="0,24,0,4" ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=DisplayProfilesProfilesHeader}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{app:Localized Key=DisplayProfilesProfilesDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="AddCurrentButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="{app:Localized Key=DisplayProfilesAddCurrent}"
                        Click="OnAddCurrentClick"
                        IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="{app:Localized Key=DisplayProfilesAddCurrent}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{app:Localized Key=DisplayProfilesNoProfiles}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoProfiles, Mode=OneWay}" />

                <ItemsControl
                    x:Name="ProfileList"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Profiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DisplayProfileItem">
                            <toolkit:SettingsCard Header="{x:Bind Name}">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE7F4;" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <toolkit:SettingsCard.Description>
                                    <StackPanel Spacing="8">
                                        <!-- The displays as they stand, also from right to left; the lines below say the same to screen readers. -->
                                        <ItemsControl
                                            Width="{x:Bind PictureWidth}"
                                            Height="{x:Bind PictureHeight}"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FlowDirection="LeftToRight"
                                            IsTabStop="False"
                                            ItemsSource="{x:Bind Picture}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:PictureDisplay">
                                                    <Grid
                                                        Width="{x:Bind Width}"
                                                        Height="{x:Bind Height}"
                                                        Margin="{x:Bind Margin}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top">
                                                        <Border
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            Visibility="{x:Bind IsNotMain}">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="{x:Bind FontSize}"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                Text="{x:Bind Label}" />
                                                        </Border>
                                                        <Border
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            Visibility="{x:Bind IsMain}">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="{x:Bind FontSize}"
                                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                Text="{x:Bind Label}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Summary}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </toolkit:SettingsCard.Description>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{app:Localized Key=DisplayProfilesInUse}"
                                        Visibility="{x:Bind IsInUse}" />
                                    <Button
                                        AutomationProperties.AutomationId="Use"
                                        AutomationProperties.Name="{x:Bind UseName}"
                                        Click="OnUseClick"
                                        Content="{app:Localized Key=DisplayProfilesUse}"
                                        IsEnabled="{x:Bind CanUse}"
                                        Tag="{x:Bind Index}"
                                        Visibility="{x:Bind IsNotInUse}" />
                                    <Button
                                        AutomationProperties.AutomationId="More"
                                        AutomationProperties.Name="{x:Bind MoreName}"
                                        Tag="{x:Bind Index}"
                                        ToolTipService.ToolTip="{x:Bind MoreName}">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    Click="OnRenameClick"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=DisplayProfilesRename}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8AC;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Click="OnUpdateClick"
                                                    IsEnabled="{x:Bind CanUpdate}"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=DisplayProfilesUpdate}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE72C;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="OnMoveUpClick"
                                                    IsEnabled="{x:Bind CanMoveUp}"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=DisplayProfilesMoveUp}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74A;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Click="OnMoveDownClick"
                                                    IsEnabled="{x:Bind CanMoveDown}"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=DisplayProfilesMoveDown}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74B;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="OnDeleteClick"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=DisplayProfilesDelete}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:Note Margin="0,16,0,0" Message="{app:Localized Key=DisplayProfilesInfo}" />

                <controls:ButtonCard
                    ButtonCommand="{x:Bind ViewModel.OpenDisplaySettingsCommand}"
                    ButtonContent="{app:Localized Key=DisplayProfilesOpenWindowsSettings}"
                    Description="{app:Localized Key=DisplayProfilesWindowsSettingsDescription}"
                    Glyph="&#xE713;"
                    Header="{app:Localized Key=DisplayProfilesWindowsSettingsHeader}" />

                <controls:PermissionsCard Description="{app:Localized Key=DisplayProfilesPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
