<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.WindowRules.WindowRulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.WindowRules"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=WindowRulesDescription}"
                    DrawnIcon="{x:Bind ViewModel.DrawnIcon}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=WindowRulesName}" />

                <Grid Margin="0,24,0,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=WindowRulesRulesHeader}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{app:Localized Key=WindowRulesRulesDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="AddRuleButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="AddRule"
                        AutomationProperties.Name="{app:Localized Key=WindowRulesAddRule}"
                        Click="OnAddRuleClick"
                        IsEnabled="{x:Bind ViewModel.CanAddRule, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="{app:Localized Key=WindowRulesAddRule}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <controls:Note
                    IsOpen="{x:Bind ViewModel.HasApplyNowResult, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ApplyNowResult, Mode=OneWay}" />

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{app:Localized Key=WindowRulesNoRules}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoRules, Mode=OneWay}" />

                <ItemsControl
                    x:Name="RuleList"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Rules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:RuleItem">
                            <toolkit:SettingsCard Description="{x:Bind Summary}" Header="{x:Bind Name}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="RuleEdit"
                                        AutomationProperties.Name="{x:Bind EditName}"
                                        Click="OnEditRuleClick"
                                        Content="{app:Localized Key=WindowRulesEdit}"
                                        Tag="{x:Bind Index}" />
                                    <ToggleSwitch
                                        AutomationProperties.Name="{x:Bind SwitchName}"
                                        IsOn="{x:Bind IsEnabled}"
                                        OffContent=""
                                        OnContent=""
                                        Tag="{x:Bind Index}"
                                        Toggled="OnRuleToggled" />
                                    <Button
                                        AutomationProperties.AutomationId="RuleMore"
                                        AutomationProperties.Name="{x:Bind MoreName}"
                                        Tag="{x:Bind Index}"
                                        ToolTipService.ToolTip="{x:Bind MoreName}">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    AutomationProperties.AutomationId="ApplyNow"
                                                    Click="OnApplyNowClick"
                                                    IsEnabled="{x:Bind CanApplyNow}"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=WindowRulesApplyNow}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE768;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="OnMoveUpClick"
                                                    IsEnabled="{x:Bind CanMoveUp}"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=WindowRulesMoveUp}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74A;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Click="OnMoveDownClick"
                                                    IsEnabled="{x:Bind CanMoveDown}"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=WindowRulesMoveDown}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74B;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="OnDeleteRuleClick"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=WindowRulesDelete}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:Note Margin="0,16,0,0" Message="{x:Bind ViewModel.AdministratorInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=WindowRulesPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
