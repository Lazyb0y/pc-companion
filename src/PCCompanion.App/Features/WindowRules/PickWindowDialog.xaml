<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PCCompanion.App.Features.WindowRules.PickWindowDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:local="using:PCCompanion.App.Features.WindowRules"
    CloseButtonText="{app:Localized Key=WindowRulesCancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonText="{app:Localized Key=WindowRulesPickWindowChoose}"
    Style="{ThemeResource DefaultContentDialogStyle}"
    Title="{app:Localized Key=WindowRulesPickWindowTitle}">

    <StackPanel MinWidth="360" Spacing="8">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{app:Localized Key=WindowRulesPickWindowNote}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="NoWindows"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{app:Localized Key=WindowRulesPickWindowNone}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <ListView
            x:Name="Windows"
            MaxHeight="360"
            AutomationProperties.Name="{app:Localized Key=WindowRulesPickWindowList}"
            ItemsSource="{x:Bind Items}"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PickedWindow">
                    <StackPanel Padding="0,6" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind AppName}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
