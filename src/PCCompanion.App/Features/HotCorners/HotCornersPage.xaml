<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.HotCorners.HotCornersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.HotCorners">

    <Page.Resources>
        <DataTemplate x:Key="CornerTemplate" x:DataType="local:CornerViewModel">
            <StackPanel Width="220" Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind ActionName}"
                    ItemsSource="{x:Bind Actions}"
                    SelectedItem="{x:Bind SelectedAction, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ActionOption">
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind KeyName}"
                    ItemsSource="{x:Bind Keys}"
                    SelectedItem="{x:Bind SelectedKey, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:KeyOption">
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Spacing="8" Visibility="{x:Bind IsProgramShown, Mode=OneWay}">
                    <TextBlock Text="{app:Localized Key=HotCornersProgramHeader}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:PathBox AccessibleName="{x:Bind ProgramName}" Path="{x:Bind Program, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{x:Bind BrowseName}"
                            Click="OnBrowseClick"
                            Content="{app:Localized Key=HotCornersBrowse}" />
                    </Grid>
                    <TextBox
                        AutomationProperties.Name="{x:Bind ArgumentsName}"
                        Header="{app:Localized Key=HotCornersArgumentsHeader}"
                        Text="{x:Bind Arguments, Mode=TwoWay}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ProgramProblem, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasProgramProblem, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{app:Localized Key=HotCornersProgramNote}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=HotCornersDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=HotCornersName}" />

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel SizeChanged="OnCornersPanelSizeChanged" Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=HotCornersCornersHeader}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{app:Localized Key=HotCornersCornersDescription}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--
                            Physical corners: the picture isn't mirrored for right-to-left languages, the text in it is.
                            Without room for it, the corners are listed one below another instead; see the code.
                        -->
                        <Grid
                            x:Name="Corners"
                            HorizontalAlignment="Center"
                            ColumnSpacing="12"
                            FlowDirection="LeftToRight"
                            RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ContentControl
                                x:Name="TopLeftCorner"
                                Content="{x:Bind ViewModel.TopLeft}"
                                ContentTemplate="{StaticResource CornerTemplate}"
                                IsTabStop="False" />
                            <ContentControl
                                x:Name="TopRightCorner"
                                Grid.Column="2"
                                Content="{x:Bind ViewModel.TopRight}"
                                ContentTemplate="{StaticResource CornerTemplate}"
                                IsTabStop="False" />
                            <Border
                                x:Name="Screen"
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="200"
                                Height="112"
                                AutomationProperties.AccessibilityView="Raw"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                BorderThickness="2"
                                CornerRadius="4" />
                            <ContentControl
                                x:Name="BottomLeftCorner"
                                Grid.Row="2"
                                Content="{x:Bind ViewModel.BottomLeft}"
                                ContentTemplate="{StaticResource CornerTemplate}"
                                IsTabStop="False" />
                            <ContentControl
                                x:Name="BottomRightCorner"
                                Grid.Row="2"
                                Grid.Column="2"
                                Content="{x:Bind ViewModel.BottomRight}"
                                ContentTemplate="{StaticResource CornerTemplate}"
                                IsTabStop="False" />
                        </Grid>
                    </StackPanel>
                </Border>

                <controls:SliderCard
                    Description="{app:Localized Key=HotCornersDelayDescription}"
                    Glyph="&#xE916;"
                    Header="{app:Localized Key=HotCornersDelayHeader}"
                    Maximum="{x:Bind local:HotCornersViewModel.MaximumActivationDelay}"
                    Minimum="0"
                    StepFrequency="50"
                    Value="{x:Bind ViewModel.ActivationDelay, Mode=TwoWay}"
                    ValueText="{x:Bind ViewModel.ActivationDelayText, Mode=OneWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=HotCornersFullScreenDescription}"
                    Glyph="&#xE740;"
                    Header="{app:Localized Key=HotCornersFullScreenHeader}"
                    IsOn="{x:Bind ViewModel.IgnoreFullScreenApps, Mode=TwoWay}" />

                <InfoBar
                    Margin="0,16,0,0"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.AdministratorInfo}"
                    Severity="Informational" />

                <controls:PermissionsCard Description="{app:Localized Key=HotCornersPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
