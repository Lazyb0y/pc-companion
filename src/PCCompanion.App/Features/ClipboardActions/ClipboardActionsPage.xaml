<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.ClipboardActions.ClipboardActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:local="using:PCCompanion.App.Features.ClipboardActions"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- Laid out like the other feature pages: a column in the middle of the page, at most 1,000 pixels wide. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel MaxWidth="1072" Padding="36,24" Spacing="4">
                <!--
                    The icon, the title and the switch share one middle line. The title's box is
                    trimmed to its capital letters, so the icon is centered on what's drawn at any
                    text size; the padding, the same above and below, keeps room for p, g and y.
                -->
                <Grid
                    Margin="0,0,0,20"
                    ColumnSpacing="16"
                    RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="32"
                        Glyph="{x:Bind local:ClipboardActionsViewModel.Glyph}" />
                    <TextBlock
                        Grid.Column="1"
                        Padding="0,8"
                        VerticalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{app:Localized Key=ClipboardActionsName}"
                        TextLineBounds="Tight" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{app:Localized Key=ClipboardActionsDescription}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{app:Localized Key=ClipboardActionsName}"
                        IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}" />
                </Grid>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Message="{app:Localized Key=FeatureSaveFailed}"
                    Severity="Error" />

                <toolkit:SettingsCard Description="{app:Localized Key=ClipboardActionsShortcutDescription}" Header="{app:Localized Key=ClipboardActionsShortcutHeader}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <TextBlock Text="{app:Localized Key=ClipboardActionsShortcut}" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="{app:Localized Key=ClipboardActionsOpenLinksDescription}" Header="{app:Localized Key=ClipboardActionsOpenLinksHeader}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE71B;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch AutomationProperties.Name="{app:Localized Key=ClipboardActionsOpenLinksHeader}" IsOn="{x:Bind ViewModel.OpenLinks, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <Grid Margin="0,24,0,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=ClipboardActionsRulesHeader}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{app:Localized Key=ClipboardActionsRulesDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="{app:Localized Key=ClipboardActionsAddRule}"
                        Click="OnAddClick"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="{app:Localized Key=ClipboardActionsAddRule}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{app:Localized Key=ClipboardActionsNoRules}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoRules, Mode=OneWay}" />

                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Rules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ClipboardRuleItem">
                            <toolkit:SettingsCard Description="{x:Bind Summary}" Header="{x:Bind Name}">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE77F;" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        AutomationProperties.Name="{x:Bind EditName}"
                                        Click="OnEditClick"
                                        Content="{app:Localized Key=ClipboardActionsEdit}"
                                        Tag="{x:Bind Index}" />
                                    <Button AutomationProperties.Name="{x:Bind MoreName}" ToolTipService.ToolTip="{x:Bind MoreName}">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    Click="OnMoveUpClick"
                                                    IsEnabled="{x:Bind CanMoveUp}"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=ClipboardActionsMoveUp}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74A;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    Click="OnMoveDownClick"
                                                    IsEnabled="{x:Bind CanMoveDown}"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=ClipboardActionsMoveDown}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74B;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Click="OnDeleteClick"
                                                    Tag="{x:Bind Index}"
                                                    Text="{app:Localized Key=ClipboardActionsDelete}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <InfoBar
                    Margin="0,16,0,0"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{app:Localized Key=ClipboardActionsAdministratorInfo}"
                    Severity="Informational" />

                <toolkit:SettingsCard Description="{app:Localized Key=ClipboardActionsPermissions}" Header="{app:Localized Key=FeaturePermissionsHeader}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
