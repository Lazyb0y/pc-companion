<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Features.DropDownApps.DropDownAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:local="using:PCCompanion.App.Features.DropDownApps"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <controls:FeatureHeader
                    Description="{app:Localized Key=DropDownAppsDescription}"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    IsOn="{x:Bind ViewModel.IsOn, Mode=TwoWay}"
                    SaveFailed="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Title="{app:Localized Key=DropDownAppsName}" />

                <controls:AppList
                    Apps="{x:Bind ViewModel.Apps}"
                    Description="{app:Localized Key=DropDownAppsAppsDescription}"
                    Header="{app:Localized Key=DropDownAppsAppsHeader}" />

                <controls:ChoiceCard
                    Margin="0,16,0,0"
                    Description="{app:Localized Key=DropDownAppsDisplayDescription}"
                    Glyph="&#xE7F4;"
                    Header="{app:Localized Key=DropDownAppsDisplayHeader}"
                    ItemsSource="{x:Bind ViewModel.Displays}"
                    SelectedItem="{x:Bind ViewModel.SelectedDisplay, Mode=TwoWay}" />

                <controls:SliderCard
                    Description="{app:Localized Key=DropDownAppsWidthDescription}"
                    Glyph="&#xE9A6;"
                    Header="{app:Localized Key=DropDownAppsWidthHeader}"
                    Maximum="{x:Bind local:DropDownAppsViewModel.MaximumSize}"
                    Minimum="{x:Bind local:DropDownAppsViewModel.MinimumWidth}"
                    StepFrequency="5"
                    Value="{x:Bind ViewModel.Width, Mode=TwoWay}"
                    ValueText="{x:Bind ViewModel.WidthText, Mode=OneWay}" />

                <controls:SliderCard
                    Description="{app:Localized Key=DropDownAppsHeightDescription}"
                    Glyph="&#xE740;"
                    Header="{app:Localized Key=DropDownAppsHeightHeader}"
                    Maximum="{x:Bind local:DropDownAppsViewModel.MaximumSize}"
                    Minimum="{x:Bind local:DropDownAppsViewModel.MinimumHeight}"
                    StepFrequency="5"
                    Value="{x:Bind ViewModel.Height, Mode=TwoWay}"
                    ValueText="{x:Bind ViewModel.HeightText, Mode=OneWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=DropDownAppsSlideDescription}"
                    Glyph="&#xE74B;"
                    Header="{app:Localized Key=DropDownAppsSlideHeader}"
                    IsOn="{x:Bind ViewModel.Slide, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=DropDownAppsHideDescription}"
                    Glyph="&#xED1A;"
                    Header="{app:Localized Key=DropDownAppsHideHeader}"
                    ItemsSource="{x:Bind ViewModel.HideOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedHide, Mode=TwoWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=DropDownAppsKeepOnTopDescription}"
                    Glyph="&#xE718;"
                    Header="{app:Localized Key=DropDownAppsKeepOnTopHeader}"
                    IsOn="{x:Bind ViewModel.KeepOnTop, Mode=TwoWay}" />

                <StackPanel Margin="0,24,0,4" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{app:Localized Key=DropDownAppsResultsHeader}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{app:Localized Key=DropDownAppsResultsDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ResultsMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasResultsMessage, Mode=OneWay}" />

                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Results}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DropDownResultItem">
                            <toolkit:SettingsCard Description="{x:Bind When}" Header="{x:Bind Text}">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="{x:Bind Glyph}" />
                                </toolkit:SettingsCard.HeaderIcon>
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:Note Margin="0,16,0,0" Message="{x:Bind ViewModel.CantDropInfo}" />

                <controls:PermissionsCard Description="{app:Localized Key=DropDownAppsPermissions}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
