<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PCCompanion.App.Controls.FeatureHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls">

    <StackPanel Spacing="4">
        <!--
            The icon, the title and the switch share one middle line. The title's box is
            trimmed to its capital letters, so the icon is centered on what's drawn at any
            text size; the padding, the same above and below, keeps room for p, g and y.
        -->
        <Grid
            Margin="0,0,0,20"
            ColumnSpacing="16"
            RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="32"
                Glyph="{x:Bind Glyph, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                Padding="0,8"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextLineBounds="Tight" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind Description, Mode=OneWay}"
                TextWrapping="Wrap" />
            <ToggleSwitch
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                IsOn="{x:Bind IsOn, Mode=TwoWay}" />
        </Grid>

        <controls:Note
            IsOpen="{x:Bind SaveFailed, Mode=OneWay}"
            Message="{app:Localized Key=FeatureSaveFailed}"
            Severity="Error" />
    </StackPanel>
</UserControl>
