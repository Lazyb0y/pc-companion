<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PCCompanion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App">

    <!--
        The backdrop is set in code: Mica on Windows 11, desktop acrylic on Windows 10.
        As in Windows Settings, the pane is open beside the page in windows at least 1,008 pixels
        wide, and folds away behind its button in narrower ones, with no compact strip of icons.
    -->
    <NavigationView
        x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        CompactModeThresholdWidth="1008"
        IsSettingsVisible="False"
        PaneDisplayMode="Auto"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" Content="{app:Localized Key=NavigationHome}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="GeneralItem" Content="{app:Localized Key=NavigationGeneral}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
