<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <TextBlock
                    Margin="0,0,0,20"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{app:Localized Key=NavigationGeneral}" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.UpdateAvailable, Mode=OneWay}"
                    Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind ViewModel.OpenReleasePageCommand}" Content="{app:Localized Key=GeneralUpdateOpenReleasePage}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Message="{app:Localized Key=GeneralSaveFailed}"
                    Severity="Error" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=GeneralLanguageDescription}"
                    Glyph="&#xF2B7;"
                    Header="{app:Localized Key=GeneralLanguageHeader}"
                    ItemsSource="{x:Bind ViewModel.Languages}"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />

                <controls:ChoiceCard
                    Description="{app:Localized Key=GeneralThemeDescription}"
                    Glyph="&#xE790;"
                    Header="{app:Localized Key=GeneralThemeHeader}"
                    ItemsSource="{x:Bind ViewModel.Themes}"
                    SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />

                <controls:SwitchCard
                    Description="{app:Localized Key=GeneralStartupDescription}"
                    Glyph="&#xE7E8;"
                    Header="{app:Localized Key=GeneralStartupHeader}"
                    IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.RunAsAdministratorFailed, Mode=OneWay}"
                    Message="{app:Localized Key=GeneralRunAsAdministratorFailed}"
                    Severity="Error" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HostWithoutAdminRights, Mode=OneWay}"
                    Message="{app:Localized Key=GeneralRunAsAdministratorHostWithoutAdminRights}"
                    Severity="Warning" />

                <controls:SwitchCard
                    Description="{x:Bind ViewModel.RunAsAdministratorDescription}"
                    Glyph="&#xE7EF;"
                    Header="{app:Localized Key=GeneralRunAsAdministratorHeader}"
                    IsOn="{x:Bind ViewModel.RunAsAdministratorOn, Mode=TwoWay}"
                    IsSwitchEnabled="{x:Bind ViewModel.RunAsAdministratorAvailable, Mode=OneWay}" />

                <toolkit:SettingsCard Description="{x:Bind ViewModel.LogsRetention}" Header="{app:Localized Key=GeneralLogsHeader}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.OpenHostLogsFolderCommand}"
                            Content="{app:Localized Key=GeneralLogsOpenHost}"
                            Visibility="{x:Bind ViewModel.HostLogsShown, Mode=OneWay}" />
                        <Button Command="{x:Bind ViewModel.OpenLogsFolderCommand}" Content="{app:Localized Key=GeneralLogsOpen}" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <controls:SwitchCard
                    Description="{x:Bind ViewModel.DetailedLoggingDescription, Mode=OneWay}"
                    Glyph="&#xEBE8;"
                    Header="{app:Localized Key=GeneralDetailedLoggingHeader}"
                    IsOn="{x:Bind ViewModel.DetailedLoggingOn, Mode=TwoWay}" />

                <!--  As in Windows Update: what the last check found, and Check now.  -->
                <toolkit:SettingsCard Description="{x:Bind ViewModel.UpdateStatusDetail, Mode=OneWay}">
                    <toolkit:SettingsCard.Header>
                        <TextBlock
                            x:Name="UpdateStatusText"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard.Header>
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.CheckingNow, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CheckingNow, Mode=OneWay}" />
                        <Button Command="{x:Bind ViewModel.CheckNowCommand}" Content="{app:Localized Key=GeneralUpdateCheckNow}" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <controls:SwitchCard
                    Description="{app:Localized Key=GeneralUpdateCheckDescription}"
                    Glyph="&#xE895;"
                    Header="{app:Localized Key=GeneralUpdateCheckHeader}"
                    IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" />

                <toolkit:SettingsCard Description="{x:Bind ViewModel.Version}" Header="{app:Localized Key=GeneralAboutHeader}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
