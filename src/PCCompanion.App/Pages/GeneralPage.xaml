<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModels="using:PCCompanion.App.ViewModels">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="36,24" Spacing="4">
            <TextBlock
                Margin="0,0,0,20"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{app:Localized Key=NavigationGeneral}" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                Message="{app:Localized Key=GeneralSaveFailed}"
                Severity="Error" />

            <toolkit:SettingsCard Description="{app:Localized Key=GeneralLanguageDescription}" Header="{app:Localized Key=GeneralLanguageHeader}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF2B7;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.Name="{app:Localized Key=GeneralLanguageHeader}"
                    ItemsSource="{x:Bind ViewModel.Languages}"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:LanguageOption">
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="{app:Localized Key=GeneralThemeDescription}" Header="{app:Localized Key=GeneralThemeHeader}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.Name="{app:Localized Key=GeneralThemeHeader}"
                    ItemsSource="{x:Bind ViewModel.Themes}"
                    SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ThemeOption">
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="{app:Localized Key=GeneralStartupDescription}" Header="{app:Localized Key=GeneralStartupHeader}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch AutomationProperties.Name="{app:Localized Key=GeneralStartupHeader}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="{x:Bind ViewModel.LogsRetention}" Header="{app:Localized Key=GeneralLogsHeader}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9F9;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button Command="{x:Bind ViewModel.OpenLogsFolderCommand}" Content="{app:Localized Key=GeneralLogsOpen}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="{x:Bind ViewModel.Version}" Header="{app:Localized Key=GeneralAboutHeader}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
