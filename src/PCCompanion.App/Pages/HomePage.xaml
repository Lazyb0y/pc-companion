<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PCCompanion.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PCCompanion.App"
    xmlns:controls="using:PCCompanion.App.Controls"
    xmlns:viewModels="using:PCCompanion.App.ViewModels">

    <!-- The page's content is a column in the middle of the page: see PageColumnStyle in App.xaml. -->
    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">
                <TextBlock
                    Margin="0,0,0,20"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{app:Localized Key=NavigationHome}" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.SaveFailed, Mode=OneWay}"
                    Message="{app:Localized Key=FeatureSaveFailed}"
                    Severity="Error" />

                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Modules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ModuleGroup">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name}" />
                                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Features}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:FeatureCardViewModel">
                                            <controls:SwitchCard
                                                Margin="0,0,0,4"
                                                Click="OnFeatureCardClick"
                                                Description="{x:Bind Description}"
                                                Glyph="{x:Bind Glyph}"
                                                Header="{x:Bind Name}"
                                                IsClickEnabled="True"
                                                IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                IsSwitchEnabled="{x:Bind IsSupported}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
