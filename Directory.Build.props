<Project>
  <PropertyGroup>
    <!-- The version of every executable, library and the installer. -->
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Low and moderate vulnerability advisories stay warnings; high and critical fail the build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    A publish folder belongs to the project being published, not to the libraries it builds.
    Without this, the installer, which publishes two projects, builds the shared libraries twice
    at the same time into the same folders.
  -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <ProjectReference>
      <GlobalPropertiesToRemove>%(GlobalPropertiesToRemove);PublishDir</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>
</Project>
