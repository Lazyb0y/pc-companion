<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!--
      The provider is a self-contained executable, which a test project may only reference without
      this check: the tests use its classes, never run it.
    -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PCCompanion.RemoteFolders\PCCompanion.RemoteFolders.csproj" />
    <ProjectReference Include="..\PCCompanion.Testing\PCCompanion.Testing.csproj" />
  </ItemGroup>
</Project>
